# ---------------------------------------------------------------
# Maas Flow Records — environment variables
# Copy to `.env` (build-time, PUBLIC_ vars) and `.dev.vars`
# (server-side secrets for `wrangler pages dev`). Never commit them.
# In production, set these in Cloudflare Pages →
# Settings → Environment variables (mark secrets as "Encrypt").
# ---------------------------------------------------------------

# --- Public (safe to expose, baked into the HTML at build time) ---
# Cloudflare Turnstile site key (spam protection on forms).
# Leave empty during local development to disable the widget.
PUBLIC_TURNSTILE_SITE_KEY=

# --- Server-side secrets (Cloudflare Pages Functions only) ---
# Cloudflare Turnstile secret key.
TURNSTILE_SECRET_KEY=

# Resend (https://resend.com) API key used to deliver form submissions by email.
RESEND_API_KEY=

# Where form submissions and order requests are delivered.
CONTACT_TO_EMAIL=info@maasflowrecords.com

# Verified sender on your Resend domain, e.g. "Maas Flow Records <noreply@maasflowrecords.com>"
CONTACT_FROM_EMAIL=

# Payment provider used by the shop checkout.
# "manual" = order request is emailed to the label, payment link sent by hand.
# Add a provider in functions/_lib/payments/ and set its id here to go live.
PAYMENT_PROVIDER=manual
