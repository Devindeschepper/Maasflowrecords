---
import '@fontsource/anton/400.css';
import '@fontsource/unifrakturcook/700.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import { site, labelSocials, turnstileSiteKey } from '../data/site';
import { getLang, LANGS, stripLang, switchLang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'music.album' | 'music.song' | 'profile';
  noindex?: boolean;
  /** Extra JSON-LD objects for this page. */
  jsonLd?: Record<string, unknown>[];
  /** No header, newsletter or footer (used by the /links page). */
  bare?: boolean;
  /** Keep the header but drop the newsletter and footer (private tool pages). */
  noFooter?: boolean;
}

const { title, description: desc, image = site.ogImage, type = 'website', noindex = false, jsonLd = [], bare = false, noFooter = false } = Astro.props;

const lang = getLang(Astro);
const t = ui[lang];
const description = desc ?? (lang === 'en' ? site.description : t.description);
const fullTitle = title ? `${title} - ${site.name}` : `${site.name} - ${t.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
// The same page in the other languages (only for pages that are translated).
const path = Astro.url.pathname;
const alternates = LANGS.map((l) => ({ lang: l, href: switchLang(path, l) }));
const translated = alternates.some((a) => a.lang !== 'en' && a.href !== stripLang(path));
const ogImage = new URL(image, site.url).href;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: new URL('/icon-512.png', site.url).href,
  sameAs: Object.values(labelSocials).filter(Boolean),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {translated && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, site.url).href} />)}
    {translated && <link rel="alternate" hreflang="x-default" href={new URL(stripLang(path), site.url).href} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {image === site.ogImage && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
    <meta property="og:locale" content={{ en: 'en_US', fr: 'fr_FR', de: 'de_DE' }[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify([orgLd, ...jsonLd]).replace(/</g, '\\u003c')} />
    {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}
    {site.analyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.analyticsToken })} />
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && !noFooter && <Newsletter />}
    {!bare && !noFooter && <Footer />}
  </body>
</html>
