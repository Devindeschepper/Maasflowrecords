---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EventCard from '../components/EventCard.astro';
import BookingForm from '../components/BookingForm.astro';
import { upcomingEvents, pastEvents } from '../data/events';
import { site } from '../data/site';

const upcoming = upcomingEvents();
const past = pastEvents();

// Only dated, real-world events go into search-engine data.
const jsonLd = upcoming.filter((e) => e.kind !== 'Release' && e.start).map((e) => ({
  '@context': 'https://schema.org',
  '@type': 'MusicEvent',
  name: e.title,
  startDate: e.start,
  description: e.description,
  image: new URL(e.image, site.url).href,
  eventAttendanceMode: e.online
    ? 'https://schema.org/OnlineEventAttendanceMode'
    : 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: e.online
    ? { '@type': 'VirtualLocation', url: e.ticketUrl || site.url }
    : { '@type': 'Place', name: e.venue, address: e.city },
  organizer: { '@type': 'Organization', name: site.name, url: site.url },
  performer: { '@type': 'MusicGroup', name: 'VIN' },
  ...(e.ticketUrl ? { offers: { '@type': 'Offer', url: e.ticketUrl } } : {}),
}));
---

<BaseLayout title="Events" description="Concerts, livestreams, performances and label events from Maas Flow Records and VIN." jsonLd={jsonLd}>
  <PageHero eyebrow="Live" title="Events" lead="Concerts, livestreams, studio sessions and label events." />

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>Upcoming</h2></div>
      {
        upcoming.length ? (
          upcoming.map((e) => <EventCard event={e} />)
        ) : (
          <p class="empty">No upcoming events right now. Follow <a href="/artists/vin/">VIN</a> for announcements.</p>
        )
      }
    </div>
  </section>

  {
    past.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head"><h2>Past events</h2></div>
          {past.map((e) => <EventCard event={e} compact />)}
        </div>
      </section>
    )
  }

  <section class="section" id="book">
    <div class="container book">
      <div class="intro">
        <p class="eyebrow"><span class="dot"></span>Bookings</p>
        <h2>Book an artist</h2>
        <p class="lead muted">Want a Maas Flow Records artist at your show, festival, club night or event? Send a request and we'll get back to you.</p>
        <p class="muted small">Prefer email? <a href="mailto:info@maasflowrecords.com">info@maasflowrecords.com</a></p>
      </div>
      <BookingForm />
    </div>
  </section>
</BaseLayout>

<style>
  .book { display: grid; gap: 2.5rem; }
  .small { font-size: 0.88rem; }
  @media (min-width: 960px) {
    .book { grid-template-columns: 1fr 1.6fr; gap: 4rem; align-items: start; }
    .intro { position: sticky; top: calc(var(--header-h) + 2rem); }
  }
</style>
