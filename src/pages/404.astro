---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="section">
    <div class="container">
      <p class="eyebrow"><span class="dot"></span>Error 404</p>
      <h1>Lost the beat.</h1>
      <p class="lead muted">This page doesn't exist (anymore). Try one of these:</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn btn-ghost" href="/music/">Music</a>
        <a class="btn btn-ghost" href="/shop/">Shop</a>
        <a class="btn btn-ghost" href="/contact/">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
