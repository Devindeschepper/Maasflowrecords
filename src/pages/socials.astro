---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PlatformLinks from '../components/PlatformLinks.astro';
import { labelSocials, site } from '../data/site';
import { artists } from '../data/artists';
import { platforms } from '../data/platforms';
import type { Links } from '../data/types';

const split = (links: Links, kind: 'social' | 'listen') =>
  Object.fromEntries(
    Object.entries(links).filter(([id]) => {
      const k = platforms[id as keyof typeof platforms].kind;
      return kind === 'social' ? k === 'social' : k !== 'social';
    }),
  ) as Links;
---

<BaseLayout title="Socials" description={`Official social media and streaming accounts of ${site.name} and VIN.`}>
  <PageHero eyebrow="Official accounts" title="Socials" lead="The only official accounts of Maas Flow Records and its artists." />

  <section class="section">
    <div class="container cols">
      <div>
        <h2>Follow</h2>
        <PlatformLinks links={split(labelSocials, 'social')} variant="list" />
      </div>
      <div>
        <h2>Listen</h2>
        <PlatformLinks links={split(labelSocials, 'listen')} variant="list" />
      </div>
    </div>
  </section>

  {
    artists.map((a) => (
      <section class="section">
        <div class="container">
          <p class="eyebrow"><span class="dot" />Artist</p>
          <h2><a href={`/artists/${a.slug}/`}>{a.name}</a></h2>
          <PlatformLinks links={{ ...a.socials, ...a.streaming }} variant="chips" />
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .cols { display: grid; gap: 3rem; }
  h2 a { text-decoration: none; }
  h2 a:hover { color: var(--accent); }
  @media (min-width: 860px) { .cols { grid-template-columns: 1fr 1fr; } }
</style>
