---
import Email from '../components/Email.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProductCard from '../components/ProductCard.astro';
import { products, shippingZones, formatPrice } from '../data/products';
import { vat, priceForZone } from '../data/vat';
import ShopComingSoon from '../components/ShopComingSoon.astro';
import TestModeBanner from '../components/TestModeBanner.astro';
import Turnstile from '../components/Turnstile.astro';
import { site, shopOpen, dropAt, shopTestMode, paymentMethods } from '../data/site';
import { getLang, localize, pick } from '../i18n';
import { ui } from '../i18n/ui';
import { categoryLabel, zoneText } from '../i18n/shop';

const categories = [...new Set(products.map((p) => p.category))];
const soldOut = products.filter((p) => p.stock <= 0);
const lang = getLang(Astro);
const L = (href: string) => localize(href, lang);
const t = pick(lang, {
  en: {
    desc: 'Official Maas Flow Records store. Music and merch straight from the label.', eyebrow: 'Official store', title: 'Shop', lead: 'Music and merch, straight from the label.',
    products: 'Products', filter: 'Filter products by category', all: 'All', cart: 'View cart',
    restock: "Sold out? Get an email when it's back", restockText: "One email when it's in stock again, then your address is deleted. No newsletter.", restockOk: "Done! We'll email you as soon as it's back.",
    product: 'Product', email: 'Email', yourEmail: 'Your email', tellMe: 'Tell me',
    shipping: 'Shipping', rates: 'Shipping rates', destination: 'Destination', delivery: 'Delivery', soon: 'Soon',
    shipsFrom: 'One shipping charge per order, however many items you order.',
    orders: 'Orders & returns', o1: 'Pre-orders ship on or around the release date. Mixed orders ship together.', o2: "You'll receive an order confirmation by email.", o3: 'Returns accepted within 14 days of delivery (EU right of withdrawal). Items must be unused.', questions: 'Questions?',
    payment: 'Payment', exempt: 'All prices in EUR. No VAT is charged (small business exemption).', withVat: (r: number) => `All prices in EUR, incl. ${r}% VAT. Orders shipped outside the EU are charged without VAT (import taxes may apply).`,
    payWith: 'Pay with', card: 'card, PayPal, Apple Pay or Google Pay (via Stripe)', crypto: 'crypto (via NOWPayments)', or: ' or ', never: 'Payment details never touch this website.', manual: "After ordering you'll receive a payment request by email.",
  },
  fr: {
    desc: 'Boutique officielle de Maas Flow Records. Musique et merch, directement du label.', eyebrow: 'Boutique officielle', title: 'Boutique', lead: 'Musique et merch, directement du label.',
    products: 'Produits', filter: 'Filtrer les produits par catégorie', all: 'Tout', cart: 'Voir le panier',
    restock: 'Épuisé ? Reçois un e-mail quand il revient', restockText: 'Un seul e-mail quand il est de retour en stock, puis ton adresse est supprimée. Pas de newsletter.', restockOk: "C'est noté ! On t'écrit dès qu'il revient.",
    product: 'Produit', email: 'E-mail', yourEmail: 'Ton e-mail', tellMe: 'Me prévenir',
    shipping: 'Livraison', rates: 'Frais de livraison', destination: 'Destination', delivery: 'Délai', soon: 'Bientôt',
    shipsFrom: "Un seul frais de port par commande, quel que soit le nombre d'articles.",
    orders: 'Commandes & retours', o1: 'Les précommandes sont expédiées autour de la date de sortie. Les commandes mixtes partent ensemble.', o2: 'Tu reçois une confirmation de commande par e-mail.', o3: 'Retours acceptés dans les 14 jours après la livraison (droit de rétractation UE). Les articles doivent être neufs.', questions: 'Des questions ?',
    payment: 'Paiement', exempt: 'Tous les prix en EUR. Pas de TVA (régime de franchise des petites entreprises).', withVat: (r) => `Tous les prix en EUR, TVA de ${r} % incluse. Les commandes livrées hors UE sont facturées sans TVA (des taxes d'importation peuvent s'appliquer).`,
    payWith: 'Paiement par', card: 'carte, PayPal, Apple Pay ou Google Pay (via Stripe)', crypto: 'crypto (via NOWPayments)', or: ' ou ', never: 'Tes données de paiement ne passent jamais par ce site.', manual: 'Après la commande, tu reçois une demande de paiement par e-mail.',
  },
  de: {
    desc: 'Offizieller Shop von Maas Flow Records. Musik und Merch direkt vom Label.', eyebrow: 'Offizieller Shop', title: 'Shop', lead: 'Musik und Merch, direkt vom Label.',
    products: 'Produkte', filter: 'Produkte nach Kategorie filtern', all: 'Alle', cart: 'Zum Warenkorb',
    restock: 'Ausverkauft? Hol dir eine E-Mail, wenn es wieder da ist', restockText: 'Eine einzige E-Mail, wenn es wieder auf Lager ist, danach wird deine Adresse gelöscht. Kein Newsletter.', restockOk: 'Erledigt! Wir schreiben dir, sobald es wieder da ist.',
    product: 'Produkt', email: 'E-Mail', yourEmail: 'Deine E-Mail', tellMe: 'Benachrichtigen',
    shipping: 'Versand', rates: 'Versandkosten', destination: 'Ziel', delivery: 'Lieferzeit', soon: 'Bald',
    shipsFrom: 'Einmal Versandkosten pro Bestellung, egal wie viele Artikel.',
    orders: 'Bestellungen & Rückgabe', o1: 'Vorbestellungen werden um das Release-Datum herum verschickt. Gemischte Bestellungen gehen zusammen raus.', o2: 'Du bekommst eine Bestellbestätigung per E-Mail.', o3: 'Rückgabe innerhalb von 14 Tagen nach Lieferung (EU-Widerrufsrecht). Die Artikel müssen unbenutzt sein.', questions: 'Fragen?',
    payment: 'Bezahlung', exempt: 'Alle Preise in EUR. Keine MwSt. (Kleinunternehmerregelung).', withVat: (r) => `Alle Preise in EUR, inkl. ${r} % MwSt. Bestellungen außerhalb der EU werden ohne MwSt. berechnet (Einfuhrabgaben möglich).`,
    payWith: 'Bezahlen mit', card: 'Karte, PayPal, Apple Pay oder Google Pay (über Stripe)', crypto: 'Krypto (über NOWPayments)', or: ' oder ', never: 'Deine Zahlungsdaten laufen nie über diese Website.', manual: 'Nach der Bestellung bekommst du eine Zahlungsaufforderung per E-Mail.',
  },
});

const jsonLd = !shopOpen ? [] : products.map((p) => ({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  description: p.description,
  image: new URL(p.image, site.url).href,
  brand: { '@type': 'Brand', name: site.name },
  offers: {
    '@type': 'Offer',
    price: (p.price / 100).toFixed(2),
    priceCurrency: 'EUR',
    availability: p.stock <= 0 ? 'https://schema.org/SoldOut' : p.preorder ? 'https://schema.org/PreOrder' : 'https://schema.org/InStock',
    url: new URL('/shop/', site.url).href,
  },
}));
---

<BaseLayout title={t.title} description={t.desc} jsonLd={jsonLd}>
  <PageHero eyebrow={t.eyebrow} title={t.title} lead={t.lead} />

  {!shopOpen && <ShopComingSoon />}
  {dropAt && <ShopComingSoon dropAt={dropAt} />}
  {shopOpen && (<div data-drop-content hidden={dropAt ? true : undefined}>
  {shopTestMode && <TestModeBanner />}

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="sr-only">{t.products}</h2>
        {categories.length > 1 ? (
          <div class="filters" role="group" aria-label={t.filter}>
            <button type="button" class="filter" aria-pressed="true" data-filter="all">{t.all}</button>
            {categories.map((c) => <button type="button" class="filter" aria-pressed="false" data-filter={c}>{categoryLabel(c, lang)}</button>)}
          </div>
        ) : <span class="eyebrow">{categories[0] ? categoryLabel(categories[0], lang) : ''}</span>}
        <a href={L('/cart/')} class="link-arrow">{t.cart}</a>
      </div>
      <div class="grid grid-3" id="product-grid">
        {products.map((p) => <div data-cat={p.category}><ProductCard product={p} /></div>)}
      </div>
    </div>
  </section>

  {soldOut.length > 0 && (
    <section class="section" id="restock">
      <div class="container restock">
        <div>
          <h2 class="h3">{t.restock}</h2>
          <p class="muted small">{t.restockText}</p>
        </div>
        <form class="form" action="/api/restock" method="post" data-ajax data-success={t.restockOk}>
          <div class="field">
            <label for="r-product">{t.product}</label>
            <select id="r-product" name="product" required>
              {soldOut.map((p) => <option value={p.id}>{p.name}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="r-email">{t.email}</label>
            <input id="r-email" name="email" type="email" required maxlength="200" autocomplete="email" placeholder={t.yourEmail} />
          </div>
          <div class="hp" aria-hidden="true">
            <label for="r-website">{ui[lang].form.website}</label>
            <input id="r-website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="_ts" value="" />
          <Turnstile appearance="interaction-only" />
          <button class="btn btn-primary" type="submit">{t.tellMe}</button>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  )}

  <section class="section" id="shipping">
    <div class="container info">
      <div>
        <h2 class="h3">{t.shipping}</h2>
        <table class="rates">
          <caption class="sr-only">{t.rates}</caption>
          <thead><tr><th scope="col">{t.destination}</th><th scope="col">{t.shipping}</th><th scope="col">{t.delivery}</th></tr></thead>
          <tbody>
            {shippingZones.map((z) => (
              <tr><th scope="row">{zoneText(z.label, lang)}</th><td>{z.price === undefined ? t.soon : formatPrice(priceForZone(z.price, z.inEU), lang)}</td><td>{zoneText(z.estimate, lang)}</td></tr>
            ))}
          </tbody>
        </table>
        <p class="muted small">{t.shipsFrom}</p>
      </div>
      <div>
        <h2 class="h3">{t.orders}</h2>
        <ul class="muted small list">
          <li>{t.o1}</li>
          <li>{t.o2}</li>
          <li>{t.o3}</li>
          <li>{t.questions} <Email /></li>
        </ul>
      </div>
      <div>
        <h2 class="h3">{t.payment}</h2>
        <p class="muted small">
          {vat.mode === 'exempt' ? t.exempt : t.withVat(vat.rate)}{' '}
          {(paymentMethods.card || paymentMethods.crypto)
            ? <>{t.payWith} {[paymentMethods.card && t.card, paymentMethods.crypto && t.crypto].filter(Boolean).join(t.or)}. {t.never}</>
            : t.manual}
        </p>
      </div>
    </div>
  </section>
  </div>)}
</BaseLayout>

<script>
  import { enhanceAddToCart } from '../scripts/shop';
  import { enhanceForms } from '../scripts/forms';
  enhanceAddToCart();
  enhanceForms();

  // "Tell me when it's back" on a sold-out card: pick that product in the form below.
  document.querySelectorAll<HTMLAnchorElement>('[data-restock]').forEach((a) =>
    a.addEventListener('click', () => {
      const select = document.querySelector<HTMLSelectElement>('#r-product');
      if (select) select.value = a.dataset.restock!;
      setTimeout(() => document.querySelector<HTMLInputElement>('#r-email')?.focus({ preventScroll: true }), 300);
    }),
  );

  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const items = document.querySelectorAll<HTMLElement>('#product-grid > [data-cat]');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      items.forEach((el) => (el.hidden = b.dataset.filter !== 'all' && el.dataset.cat !== b.dataset.filter));
    }),
  );
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .filter {
    min-height: 40px; padding: 0.4rem 0.85rem; background: none; color: var(--muted);
    border: 1px solid var(--line); font: 500 0.72rem/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer;
  }
  .filter[aria-pressed='true'] { color: var(--bg); background: var(--text); border-color: var(--text); }
  #product-grid > div { display: flex; }
  #product-grid > div > :global(*) { flex: 1; }
  #product-grid > div[hidden] { display: none; }
  .restock { display: grid; gap: 1.5rem; max-width: 900px; }
  .restock .form { display: grid; gap: 0.75rem; }
  @media (min-width: 900px) { .restock { grid-template-columns: 1fr 1.2fr; gap: 3rem; } }
  .info { display: grid; gap: 2.5rem; }
  .info > div { min-width: 0; }
  .h3 { font-size: clamp(1.35rem, 3vw, 1.75rem); }
  .small { font-size: 0.88rem; }
  .list { padding-left: 1.1rem; margin: 0; }
  .list li { padding: 0.2rem 0; }
  .rates { width: 100%; border-collapse: collapse; font-size: 0.82rem; margin-bottom: 0.75rem; display: block; overflow-x: auto; }
  .rates th, .rates td { text-align: left; padding: 0.55rem 0.6rem 0.55rem 0; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .rates td:last-child { white-space: normal; min-width: 7rem; }
  .rates thead th { font: 500 0.66rem var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  @media (min-width: 960px) { .info { grid-template-columns: 1.4fr 1fr 1fr; gap: 3rem; } }
</style>
