---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { artists } from '../../data/artists';
import { getLang, localize, pick } from '../../i18n';

const lang = getLang(Astro);
const t = pick(lang, {
  en: { title: 'Artists', desc: 'The Maas Flow Records roster: VIN, producer and rapper from Rotterdam.', eyebrow: 'Roster', lead: 'Independent, hands-on, always learning.', join: 'Want to work with the label?', send: 'Send us your music' },
  fr: { title: 'Artistes', desc: 'Les artistes de Maas Flow Records : VIN, producteur et rappeur de Rotterdam.', eyebrow: 'Roster', lead: 'Indépendants, impliqués, toujours en train d’apprendre.', join: 'Tu veux travailler avec le label ?', send: 'Envoie-nous ta musique' },
  de: { title: 'Artists', desc: 'Die Artists von Maas Flow Records: VIN, Producer und Rapper aus Rotterdam.', eyebrow: 'Roster', lead: 'Unabhängig, hands-on, immer am Lernen.', join: 'Du willst mit dem Label arbeiten?', send: 'Schick uns deine Musik' },
});
---

<BaseLayout title={t.title} description={t.desc}>
  <PageHero eyebrow={t.eyebrow} title={t.title} lead={t.lead} />

  <section class="section">
    <div class="container">
      <ul class="roster">
        {
          artists.map((a, i) => (
            <li>
              <a href={localize(`/artists/${a.slug}/`, lang)} class="row">
                <span class="mono muted num">{String(i + 1).padStart(2, '0')}</span>
                <img src={a.image} alt={a.imageAlt} width="360" height="450" loading="lazy" />
                <span class="text">
                  <span class="name">{a.name}</span>
                  <span class="mono muted">{a.roles.join(' / ')} · {a.origin}</span>
                  <span class="tagline">{a.tagline}</span>
                </span>
                <span class="go" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="muted join">
        {t.join} <a href={localize('/casting/', lang)}>{t.send}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .roster { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .roster li { border-bottom: 1px solid var(--line); }
  .row { display: grid; grid-template-columns: 1fr; gap: 1rem; padding: 1.5rem 0; text-decoration: none; align-items: center; }
  .num { display: none; }
  .row img { width: 100%; max-width: 360px; aspect-ratio: 4 / 5; object-fit: cover; border: 1px solid var(--line); }
  .text { display: grid; gap: 0.35rem; }
  .name { font-family: var(--font-display); font-size: clamp(4rem, 14vw, 8rem); line-height: 0.9; text-transform: uppercase; }
  .tagline { font-size: 1.1rem; }
  .go { font-size: 2rem; transition: transform 0.15s; }
  .row:hover .name { color: var(--accent); }
  .row:hover .go { transform: translateX(6px); }
  .join { margin-top: 2rem; }
  @media (min-width: 800px) {
    .row { grid-template-columns: 50px 220px 1fr auto; gap: 2rem; }
    .num { display: block; }
  }
</style>
