---
import { photoSrcset } from '../../data/img';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReleaseCard from '../../components/ReleaseCard.astro';
import PlatformLinks from '../../components/PlatformLinks.astro';
import SpotifyPlayer from '../../components/SpotifyPlayer.astro';
import { artists } from '../../data/artists';
import { releasesByArtist } from '../../data/releases';
import { site } from '../../data/site';
import type { Artist } from '../../data/types';
import { getLang, localize, pick } from '../../i18n';

export function getStaticPaths() {
  return artists.map((artist) => ({ params: { slug: artist.slug }, props: { artist } }));
}

const { artist: a } = Astro.props as { artist: Artist };
const music = releasesByArtist(a.slug);
const lang = getLang(Astro);
const L = (href: string) => localize(href, lang);
const t = pick(lang, {
  en: { from: 'from', on: 'on', bio: 'Read full bio', book: 'Book', music: 'Music', beats: 'Buy beats', listen: 'Listen', follow: 'Follow', releases: 'Releases', catalogue: 'Full catalogue', none: 'No releases yet.' },
  fr: { from: 'de', on: 'sur', bio: 'Lire la bio complète', book: 'Booker', music: 'Musique', beats: 'Acheter des beats', listen: 'Écouter', follow: 'Suivre', releases: 'Sorties', catalogue: 'Tout le catalogue', none: 'Pas encore de sorties.' },
  de: { from: 'aus', on: 'bei', bio: 'Ganze Bio lesen', book: 'Buchen:', music: 'Musik', beats: 'Beats kaufen', listen: 'Anhören', follow: 'Folgen', releases: 'Releases', catalogue: 'Ganzer Katalog', none: 'Noch keine Releases.' },
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MusicGroup',
    name: a.name,
    genre: ['Hip hop', 'R&B'],
    foundingLocation: a.origin,
    image: new URL(a.image, site.url).href,
    url: new URL(`/artists/${a.slug}/`, site.url).href,
    recordLabel: { '@type': 'Organization', name: site.name },
    sameAs: [...Object.values(a.streaming), ...Object.values(a.socials)].filter(Boolean),
  },
];
---

<BaseLayout title={a.name} description={`${a.name} - ${a.roles.join(', ').toLowerCase()} ${t.from} ${a.origin}, ${t.on} ${site.name}. ${a.tagline}`} image={a.image} type="profile" jsonLd={jsonLd}>
  <section class="artist-hero">
    <div class="container grid-hero">
      <div class="photo">
        <img src={a.image} srcset={photoSrcset(a.image)} sizes="(max-width: 800px) 100vw, 600px" alt={a.imageAlt} width="720" height="900" fetchpriority="high" />
      </div>
      <div class="intro">
        <p class="eyebrow"><span class="dot"></span>{a.roles.join(' / ')} · {a.origin}</p>
        <h1>{a.name}</h1>
        <p class="lead">{a.tagline}</p>
        <p class="muted">{a.description}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={L(a.bioHref)}>{t.bio}</a>
          <a class="btn btn-ghost" href={L(`/events/?artist=${a.slug}#book`)}>{t.book} {a.name}</a>
          <a class="btn btn-ghost" href="#music">{t.music}</a>
          {a.streaming.beatstars && <a class="btn btn-ghost" href={a.streaming.beatstars} target="_blank" rel="noopener noreferrer">{t.beats}</a>}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div>
        <h2>{t.listen}</h2>
        {a.streaming.spotify && <div class="player"><SpotifyPlayer url={a.streaming.spotify} title={a.name} /></div>}
        <PlatformLinks links={a.streaming} variant="list" />
      </div>
      <div>
        <h2>{t.follow}</h2>
        <PlatformLinks links={a.socials} variant="list" />
      </div>
    </div>
  </section>

  <section class="section" id="music">
    <div class="container">
      <div class="section-head">
        <h2>{t.releases}</h2>
        <a class="link-arrow" href={L('/music/')}>{t.catalogue}</a>
      </div>
      {music.length ? <div class="grid grid-4">{music.map((r) => <ReleaseCard release={r} />)}</div> : <p class="empty">{t.none}</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .artist-hero { padding-block: clamp(2rem, 6vw, 4rem); border-bottom: 1px solid var(--line); }
  .grid-hero { display: grid; gap: 2rem; align-items: end; }
  .photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border: 1px solid var(--line); }
  .intro h1 { font-size: clamp(5rem, 22vw, 12rem); line-height: 0.85; }
  .intro .muted { max-width: 60ch; }
  .two-col { display: grid; gap: 3rem; }
  @media (min-width: 860px) {
    .grid-hero { grid-template-columns: 1fr 1.2fr; gap: 4rem; }
    .two-col { grid-template-columns: 1fr 1fr; }
  }
  .player { margin-bottom: 1.25rem; }
</style>
