---
// Link-in-bio page for the Instagram / TikTok bio: maasflowrecords.com/links
// Everything is filled in from the same data as the rest of the site, so it updates by itself
// (next release, latest single, streaming links, BeatStars).
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import PlatformLinks from '../components/PlatformLinks.astro';
import PlatformIcon from '../components/PlatformIcon.astro';
import Newsletter from '../components/Newsletter.astro';
import { labelSocials } from '../data/site';
import { artists } from '../data/artists';
import { latestRelease, upcomingReleases } from '../data/releases';
import { beats } from '../data/services';
import { outLabel } from '../lib/format';
import { getLang, localize, pick } from '../i18n';

const vin = artists[0];
const next = upcomingReleases()[0];
const latest = latestRelease();
const lang = getLang(Astro);
const L = (href: string) => localize(href, lang);
const t = pick(lang, {
  en: { new: 'new', outNow: 'out now', soon: 'Coming soon', onSpotify: 'Listen on Spotify', on: 'VIN on', followNew: 'Follow for new releases', beats: 'Buy beats', beatsSub: 'Leases & exclusives on BeatStars', mixing: 'Mixing & mastering', request: 'Send a request', send: 'Send us your music', sendSub: 'Singers, rappers, producers, musicians', events: 'Events & booking', website: 'Website', desc: 'All Maas Flow Records links: new music from VIN, streaming, beats, mixing & mastering and casting.', tagline: 'Independent music label · Founded by VIN', social: 'Maas Flow Records on' },
  fr: { new: 'nouveau', outNow: 'disponible', soon: 'Bientôt', onSpotify: 'Écouter sur Spotify', on: 'VIN sur', followNew: 'Abonne-toi pour les nouvelles sorties', beats: 'Acheter des beats', beatsSub: 'Leases & exclusives sur BeatStars', mixing: 'Mix & mastering', request: 'Envoyer une demande', send: 'Envoie-nous ta musique', sendSub: 'Chanteurs, rappeurs, producteurs, musiciens', events: 'Événements & booking', website: 'Site web', desc: 'Tous les liens Maas Flow Records : nouvelle musique de VIN, streaming, beats, mix & mastering et casting.', tagline: 'Label de musique indépendant · Fondé par VIN', social: 'Maas Flow Records sur' },
  de: { new: 'neue', outNow: 'jetzt draußen', soon: 'Demnächst', onSpotify: 'Auf Spotify anhören', on: 'VIN auf', followNew: 'Folgen für neue Releases', beats: 'Beats kaufen', beatsSub: 'Leases & Exclusives auf BeatStars', mixing: 'Mixing & Mastering', request: 'Anfrage senden', send: 'Schick uns deine Musik', sendSub: 'Sänger, Rapper, Producer, Musiker', events: 'Events & Booking', website: 'Website', desc: 'Alle Links von Maas Flow Records: neue Musik von VIN, Streaming, Beats, Mixing & Mastering und Casting.', tagline: 'Unabhängiges Musiklabel · Gegründet von VIN', social: 'Maas Flow Records auf' },
});

type Item = { href: string; title: string; sub?: string; icon?: 'spotify' | 'appleMusic' | 'youtubeMusic' | 'beatstars'; external?: boolean; featured?: boolean };

const items: Item[] = [
  ...(next ? [{ href: L(`/music/${next.slug}/`), title: `${next.title} - ${t.new} ${next.type}`, sub: next.releaseDate ? outLabel(next, lang) : t.soon, featured: true }] : []),
  ...(latest
    ? [
        latest.links.spotify
          ? { href: latest.links.spotify, title: `${latest.title} - ${t.outNow}`, sub: t.onSpotify, icon: 'spotify' as const, external: true, featured: !next }
          : { href: L(`/music/${latest.slug}/`), title: `${latest.title} - ${t.outNow}`, featured: !next },
      ]
    : []),
  ...(vin.streaming.spotify ? [{ href: vin.streaming.spotify, title: `${t.on} Spotify`, sub: t.followNew, icon: 'spotify' as const, external: true }] : []),
  ...(vin.streaming.appleMusic ? [{ href: vin.streaming.appleMusic, title: `${t.on} Apple Music`, icon: 'appleMusic' as const, external: true }] : []),
  ...(vin.streaming.youtubeMusic ? [{ href: vin.streaming.youtubeMusic, title: `${t.on} YouTube Music`, icon: 'youtubeMusic' as const, external: true }] : []),
  ...(beats.beatstars ? [{ href: beats.beatstars, title: t.beats, sub: t.beatsSub, icon: 'beatstars' as const, external: true }] : []),
  { href: L('/services/'), title: t.mixing, sub: t.request },
  { href: L('/casting/'), title: t.send, sub: t.sendSub },
  { href: L('/events/'), title: t.events },
  { href: L('/'), title: t.website, sub: 'maasflowrecords.com' },
];
---

<BaseLayout title="Links" description={t.desc} bare noindex>
  <div class="links-page">
    <header class="top">
      <h1 class="brand"><a href={L('/')}><Logo size="lg" /></a></h1>
      <p class="muted">{t.tagline}</p>
      <PlatformLinks links={labelSocials} variant="icons" context={t.social} />
    </header>

    <ul class="list">
      {
        items.map((i) => (
          <li>
            <a
              class:list={['item', { featured: i.featured }]}
              href={i.href}
              {...(i.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {i.icon && <PlatformIcon id={i.icon} size={22} />}
              <span class="text">
                <strong>{i.title}</strong>
                {i.sub && <span class="sub">{i.sub}</span>}
              </span>
              <span class="go" aria-hidden="true">{i.external ? '↗' : '→'}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <Newsletter />
</BaseLayout>

<style>
  .brand { margin: 0; font-size: inherit; line-height: 1; text-transform: none; letter-spacing: normal; font-weight: inherit; }
  .links-page { max-width: 560px; margin-inline: auto; padding: clamp(2rem, 7vw, 3.5rem) var(--gutter) 1rem; }
  .top { display: grid; justify-items: center; gap: 0.9rem; text-align: center; margin-bottom: 2rem; }
  .top p { margin: 0; font-size: 0.9rem; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .item {
    display: flex; align-items: center; gap: 0.9rem; min-height: 64px; padding: 0.85rem 1.1rem;
    border: 1px solid var(--line); background: var(--surface); color: var(--text); text-decoration: none;
    transition: border-color 0.15s;
  }
  .item:hover, .item:focus-visible { border-color: var(--text); }
  .item.featured { background: var(--text); color: var(--bg); border-color: var(--text); }
  .item.featured .sub { color: inherit; opacity: 0.7; }
  .item.featured:hover { background: var(--accent); border-color: var(--accent); color: #fff; }
  .text { flex: 1; display: grid; gap: 0.1rem; }
  .text strong { font-size: 0.98rem; }
  .sub { font-size: 0.8rem; color: var(--muted); }
  .go { font-size: 1.1rem; }
</style>
