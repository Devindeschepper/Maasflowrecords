---
// Private studio stats for VIN: hours in FL Studio and knocks from visitors.
// The numbers come from /api/studio/stats, which needs the STUDIO_TOKEN; this page only asks for it
// and remembers it in this browser. Not linked anywhere and not indexed.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Studio stats" description="Private studio stats." noindex noFooter>
  <div class="hero-wrap" data-hero hidden><PageHero eyebrow="Private" title="Studio stats" lead="Studio hours, followers and website visits." /></div>

  <section class="section">
    <div class="container">
      <form class="unlock" data-unlock hidden>
        <span class="door-sign" aria-hidden="true">Studio</span>
        <p class="kicker mono">Private</p>
        <h1>Studio stats</h1>
        <p class="muted">Hours in FL Studio and knocks on the door.</p>
        <label class="sr-only" for="studio-token">Password</label>
        <input id="studio-token" type="password" autocomplete="current-password" placeholder="Password" required />
        <button class="btn btn-primary" type="submit">Open stats</button>
        <p class="error" data-error hidden></p>
      </form>

      <div class="stats" data-stats hidden>

        <h2 class="h3 sec">Studio</h2>
        <div class="tiles">
          <div class="tile"><span class="mono muted">This week</span><strong data-k="week.hours"></strong><span data-k="week.meta"></span></div>
          <div class="tile"><span class="mono muted">This month</span><strong data-k="month.hours"></strong><span data-k="month.meta"></span></div>
          <div class="tile"><span class="mono muted">All time</span><strong data-k="all.hours"></strong><span data-k="all.meta"></span></div>
        </div>


        <section class="followers" data-followers hidden>
          <h2 class="h3 sec">Followers</h2>
          <p class="tiktok-note mono" data-tiktok-note hidden></p>
          <ul class="f-list" data-follower-list></ul>
          <p class="f-note mono muted" data-follower-note></p>
        </section>

        <section class="site-visits" data-visitors hidden>
          <h2 class="h3 sec">Website <span class="mono muted">last 7 days · vs week before</span></h2>
          <div class="v-grid">
            <div class="v-tile"><span class="mono muted">Visits</span><strong data-v="visits"></strong><span class="v-trend" data-v="visits-trend"></span></div>
            <div class="v-tile"><span class="mono muted">Page views</span><strong data-v="views"></strong><span class="v-trend" data-v="views-trend"></span></div>
            <div class="v-tile v-days"><span class="mono muted">Visits per day</span><div class="v-bars" data-v="days"></div></div>
            <div class="v-tile v-pages"><span class="mono muted">Top pages</span><ol data-v="pages"></ol></div>
          </div>
          <p class="v-error mono" data-v="error" hidden></p>
        </section>

        <button class="btn btn-ghost lock" type="button" data-lock>Forget password on this device</button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  type Sum = { ms: number; hours: number; sessions: number; knocks: number };
  type Stats = {
    ok: boolean; error?: string; live: boolean; week: Sum; month: Sum; all: Sum;
    visitors?: { visits: number; views: number; prevVisits: number; prevViews: number; days: { date: string; visits: number; views: number }[]; pages: { path: string; views: number }[]; error?: string } | null;
    followers?: { key: string; label: string; platform: string; count: number | null; week: number | null; month: number | null; monthSince: string | null; at: string | null; error?: string }[];
  };

  const KEY = 'mfr-studio-token';
  const form = document.querySelector<HTMLFormElement>('[data-unlock]')!;
  const input = document.querySelector<HTMLInputElement>('#studio-token')!;
  const error = document.querySelector<HTMLElement>('[data-error]')!;
  const box = document.querySelector<HTMLElement>('[data-stats]')!;
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;

  const store = {
    get: () => { try { return localStorage.getItem(KEY) ?? ''; } catch { return ''; } },
    set: (v: string) => { try { localStorage.setItem(KEY, v); } catch { /* private mode */ } },
    clear: () => { try { localStorage.removeItem(KEY); } catch { /* private mode */ } },
  };

  const dur = (ms: number) => {
    const min = Math.round(ms / 60000);
    const h = Math.floor(min / 60);
    return h ? `${h}h ${String(min % 60).padStart(2, '0')}m` : `${min}m`;
  };
  const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;

  function render(s: Stats) {
    const set = (k: string, v: string) => { const el = box.querySelector(`[data-k="${k}"]`); if (el) el.textContent = v; };
    for (const [name, sum] of [['week', s.week], ['month', s.month], ['all', s.all]] as const) {
      set(`${name}.hours`, dur(sum.ms));
      set(`${name}.meta`, `${plural(sum.sessions, 'session')} · ${plural(sum.knocks, 'knock')}`);
    }

    // Followers: latest count per account and the change over the last 7 days.
    const fol = s.followers ?? [];
    const fBox = box.querySelector<HTMLElement>('[data-followers]')!;
    fBox.hidden = fol.length === 0;
    // Our own messages are readable; network/HTTP errors get a generic text (details in the tooltip).
    const friendly = (e?: string) => (!e ? 'Not available yet' : /^HTTP|internal error|fetch|timed? ?out|abort/i.test(e) ? "Couldn't load right now" : e);
    const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const change = (n: number, label: string) =>
      `<span class="f-week ${n > 0 ? 'up' : n < 0 ? 'down' : ''}">${n > 0 ? '▲' : n < 0 ? '▼' : '•'} ${Math.abs(n).toLocaleString('en-US')} <span class="f-when">${label}</span></span>`;
    const sinceLabel = (iso: string | null) => (iso ? `since ${new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}` : 'last month');

    // All platforms together: sum of the latest counts and of each account's change.
    const counted = fol.filter((f) => f.count !== null);
    const withChange = counted.filter((f) => f.week !== null && f.month !== null);
    const sum = (k: 'count' | 'week' | 'month', list: typeof fol) => list.reduce((n, f) => n + (f[k] ?? 0), 0);
    const totalSince = withChange.map((f) => f.monthSince).filter((d): d is string => !!d).sort()[0] ?? null;
    const total = counted.length
      ? `<li class="f-total">
          <span class="f-name"><span class="mono muted">All platforms</span>${plural(counted.length, 'account')}</span>
          <strong>${sum('count', counted).toLocaleString('en-US')}</strong>${
            withChange.length ? `<span class="f-changes">${change(sum('week', withChange), 'last 7 days')}${change(sum('month', withChange), sinceLabel(totalSince))}</span>` : ''}</li>`
      : '';

    box.querySelector('[data-follower-list]')!.innerHTML = total + fol
      .map((f) => {
        const [platform, name] = f.label.split(' · ');
        // TikTok needs a one-time "Connect" (TikTok login); after that the count updates by itself.
        if (f.platform === 'tiktok' && f.count === null && f.error === 'TikTok not connected') {
          return `<li class="f-tiktok">
          <span class="f-name"><span class="mono muted">${esc(platform)}</span>${esc(name ?? '')}</span>
          <button class="btn f-connect" type="button" data-tiktok-connect="${f.key === 'tt-mfr' ? 'MFR' : 'VIN'}">Connect</button>
          <span class="f-week muted">${f.key === 'tt-mfr' ? 'Log in as @maasflowrecords' : 'One time only'}</span></li>`;
        }
        const count = f.count === null ? '—' : f.count.toLocaleString('en-US');
        // Change lines under the number: last 7 days and last month (or since tracking started).
        const monthLabel = sinceLabel(f.monthSince);
        const week =
          f.week === null || f.month === null ? ''
          : `<span class="f-changes">${change(f.week, 'last 7 days')}${change(f.month, monthLabel)}</span>`;
        return `<li class="f-${f.platform}">
          <span class="f-name"><span class="mono muted">${esc(platform)}</span>${esc(name ?? '')}</span>
          <strong>${count}</strong>${f.count === null ? `<span class="f-week down" title="${esc(f.error ?? '')}">${esc(friendly(f.error))}</span>` : week}</li>`;
      })
      .join('');
    box.querySelectorAll<HTMLButtonElement>('[data-tiktok-connect]').forEach((b) => b.addEventListener('click', connectTikTok));
    // Website visitors (Cloudflare Web Analytics).
    const v = s.visitors;
    const vBox = box.querySelector<HTMLElement>('[data-visitors]')!;
    vBox.hidden = !v;
    if (v) {
      const q = (k: string) => vBox.querySelector<HTMLElement>(`[data-v="${k}"]`)!;
      const trend = (now: number, prev: number) => {
        if (!prev) return { text: now ? 'new' : '', cls: '' };
        const pct = Math.round(((now - prev) / prev) * 100);
        return { text: `${pct >= 0 ? '▲' : '▼'} ${Math.abs(pct)}%`, cls: pct >= 0 ? 'up' : 'down' };
      };
      q('visits').textContent = v.visits.toLocaleString('en-US');
      q('views').textContent = v.views.toLocaleString('en-US');
      for (const [k, now, prev] of [['visits-trend', v.visits, v.prevVisits], ['views-trend', v.views, v.prevViews]] as const) {
        const t = trend(now, prev);
        q(k).textContent = t.text;
        q(k).className = `v-trend ${t.cls}`;
      }
      const maxD = Math.max(1, ...v.days.map((d) => d.visits));
      q('days').innerHTML = v.days
        .map((d) => {
          const day = new Date(`${d.date}T12:00:00Z`).toLocaleDateString('en-GB', { weekday: 'short' });
          return `<div class="v-day" title="${d.date}: ${d.visits} visits, ${d.views} views"><span class="v-num">${d.visits || ''}</span><span class="v-bar"><span style="height:${d.visits ? Math.max(4, (d.visits / maxD) * 100) : 0}%"></span></span><span class="v-lbl">${day}</span></div>`;
        })
        .join('');
      q('pages').innerHTML = v.pages.length
        ? v.pages.map((pg) => `<li><span>${pg.path === '/' ? 'Home' : esc(pg.path)}</span><b>${pg.views.toLocaleString('en-US')}</b></li>`).join('')
        : '<li class="muted">No visits yet</li>';
      q('error').hidden = !v.error;
      q('error').textContent = v.error ? `Couldn't load visitor data right now.` : '';
      q('error').title = v.error ?? '';
    }

    const latest = fol.map((f) => f.at).filter(Boolean).sort().pop();
    box.querySelector('[data-follower-note]')!.textContent = latest
      ? `Checked ${new Date(latest).toLocaleString('en-GB', { weekday: 'short', hour: '2-digit', minute: '2-digit' })} · updates daily`
      : '';

  }

  async function load(token: string) {
    error.hidden = true;
    try {
      const res = await fetch('/api/studio/stats', { headers: { Authorization: `Bearer ${token}`, Accept: 'application/json' } });
      const data = (await res.json()) as Stats;
      if (!data.ok) throw new Error(data.error ?? 'Could not load the stats.');
      store.set(token);
      render(data);
      form.hidden = true;
      box.hidden = false;
      hero.hidden = false;
    } catch (err) {
      store.clear();
      box.hidden = true;
      hero.hidden = true;
      form.hidden = false;
      error.textContent = err instanceof Error ? err.message : 'Could not load the stats.';
      error.hidden = false;
    }
  }

  async function connectTikTok(e: Event) {
    const btn = e.currentTarget as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Opening TikTok…';
    try {
      const res = await fetch(`/api/tiktok/connect?account=${btn.dataset.tiktokConnect}`, { headers: { Authorization: `Bearer ${store.get()}`, Accept: 'application/json' } });
      const data = (await res.json()) as { ok: boolean; url?: string; error?: string };
      if (!data.ok || !data.url) throw new Error(data.error ?? 'Could not open TikTok.');
      location.href = data.url;
    } catch (err) {
      btn.disabled = false;
      btn.textContent = err instanceof Error ? err.message : 'Try again';
    }
  }

  // Back from the TikTok login: short note, then a clean URL.
  const tiktok = new URLSearchParams(location.search).get('tiktok');
  if (tiktok) {
    const note = document.querySelector<HTMLElement>('[data-tiktok-note]')!;
    note.textContent =
      tiktok === 'connected' ? 'TikTok connected. Your followers now update by themselves.'
      : tiktok === 'same' ? 'That TikTok account is already on the other card. Switch account in TikTok and try again.'
      : "TikTok couldn't be connected. Try again.";
    note.classList.toggle('bad', tiktok !== 'connected');
    note.hidden = false;
    history.replaceState(null, '', location.pathname);
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); load(input.value.trim()); });
  document.querySelector('[data-lock]')!.addEventListener('click', () => { store.clear(); location.reload(); });

  const saved = store.get();
  if (saved) load(saved);
  else form.hidden = false;
</script>

<style>
  [data-hero][hidden] { display: none; }
  /* Login: a centered card under an unlit studio-door sign. */
  .unlock {
    max-width: 400px; margin: clamp(1rem, 6vh, 4rem) auto; display: grid; gap: 0.75rem; justify-items: center; text-align: center;
    padding: 2.25rem 1.75rem 2rem; border: 1px solid var(--line); border-top: 3px solid var(--accent);
    background: linear-gradient(180deg, rgba(228, 67, 45, 0.08), transparent 45%), var(--surface);
  }
  .unlock[hidden], .stats[hidden], .error[hidden] { display: none; }
  .door-sign {
    font-family: var(--font-display); font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase;
    padding: 0.35rem 0.75rem 0.3rem; border-radius: 3px; color: #fff4ef; background: var(--accent); border: 1px solid #ff7a63;
    text-shadow: 0 0 6px rgba(255, 220, 210, 0.8); box-shadow: 0 0 12px rgba(228, 67, 45, 0.7), 0 0 30px rgba(228, 67, 45, 0.3);
    margin-bottom: 0.5rem;
  }
  .unlock .kicker { margin: 0; color: var(--accent); font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .unlock h1 { margin: 0; font-size: clamp(2.4rem, 9vw, 3.2rem); line-height: 1; }
  .unlock .muted { margin: 0 0 0.75rem; }
  .unlock input { width: 100%; text-align: center; }
  .unlock .btn { width: 100%; }
  .error { color: var(--accent); margin: 0; font-size: 0.9rem; }
  .lock { margin-top: 2.5rem; }
  .followers { margin-bottom: 2.5rem; }
  .followers .h3 { margin: 0 0 0.75rem; }
  .f-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); }
  @media (max-width: 600px) { .f-list { grid-template-columns: 1fr 1fr; gap: 0.5rem; } .f-list :global(li) { padding: 0.8rem 0.85rem; } .f-list :global(strong) { font-size: 1.6rem; } }
  .f-list :global(li) { display: grid; gap: 0.35rem; padding: 1rem 1.15rem; border: 1px solid var(--line); background: var(--surface); border-left: 3px solid var(--line); }
  .f-list :global(li.f-instagram) { border-left-color: #c13584; }
  .f-list :global(li.f-youtube) { border-left-color: #ff0033; }
  .f-list :global(li.f-tiktok) { border-left-color: #25f4ee; }
  .f-list :global(li.f-total) { grid-column: 1 / -1; border-left-color: var(--accent); background: linear-gradient(90deg, rgba(228, 67, 45, 0.1), transparent 60%), var(--surface); }
  .f-list :global(li.f-total strong) { font-size: 2.8rem; }
  .f-list :global(.f-connect) { padding: 0.55rem 0.8rem; font-size: 0.8rem; justify-self: start; }
  .tiktok-note { margin: 0 0 0.75rem; font-size: 0.8rem; color: var(--ok, #7fbf7f); }
  .tiktok-note.bad { color: var(--accent); }
  .tiktok-note[hidden] { display: none; }
  .f-list :global(.f-name) { display: grid; gap: 0.15rem; font-size: 0.9rem; }
  .f-list :global(.f-name .mono) { font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .f-list :global(strong) { font-family: var(--font-display); font-weight: 400; font-size: 2rem; line-height: 1; }
  .f-list :global(.f-week) { font-size: 0.8rem; color: var(--muted, #9b978f); }
  .f-list :global(.f-week.up) { color: var(--ok, #7fbf7f); }
  .f-list :global(.f-week.down) { color: var(--accent); }
  .f-list :global(.f-changes) { display: grid; gap: 0.15rem; }
  .f-list :global(.f-when) { color: var(--muted, #9b978f); font-size: 0.7rem; }
  .f-note { font-size: 0.7rem; margin: 0.6rem 0 0; }

  .site-visits { margin-bottom: 2.5rem; }
  .site-visits .h3 { margin: 0 0 0.75rem; display: flex; align-items: baseline; gap: 0.75rem; }
  .site-visits .h3 .mono { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .v-grid { display: grid; gap: 0.75rem; grid-template-columns: 1fr 1fr 2fr 2fr; align-items: start; }
  .v-tile { display: grid; gap: 0.4rem; align-content: start; padding: 1rem 1.15rem; border: 1px solid var(--line); background: var(--surface); }
  .v-tile > .mono { font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .v-tile strong { font-family: var(--font-display); font-weight: 400; font-size: 2.2rem; line-height: 1; }
  .v-trend { font-size: 0.8rem; color: var(--muted, #9b978f); }
  .v-trend.up { color: var(--ok, #7fbf7f); }
  .v-trend.down { color: var(--accent); }
  .v-bars { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.35rem; height: 92px; }
  .v-bars :global(.v-day) { display: grid; grid-template-rows: auto 1fr auto; gap: 0.2rem; text-align: center; min-width: 0; }
  .v-bars :global(.v-num) { font-family: var(--font-mono); font-size: 0.6rem; color: var(--muted, #9b978f); height: 1em; }
  .v-bars :global(.v-bar) { position: relative; background: #1c1b1a; border-radius: 2px; }
  .v-bars :global(.v-bar span) { position: absolute; left: 0; right: 0; bottom: 0; background: var(--accent); border-radius: 2px; }
  .v-bars :global(.v-lbl) { font-family: var(--font-mono); font-size: 0.55rem; color: var(--muted, #9b978f); }
  .v-pages ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; font-size: 0.85rem; }
  .v-pages :global(li) { display: flex; justify-content: space-between; gap: 0.75rem; border-bottom: 1px solid var(--line); padding-bottom: 0.3rem; }
  .v-pages :global(li span) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .v-pages :global(li b) { font-family: var(--font-mono); font-weight: 400; }
  .v-error { font-size: 0.75rem; color: var(--accent); margin: 0.6rem 0 0; }
  @media (max-width: 860px) { .v-grid { grid-template-columns: 1fr 1fr; } .v-days, .v-pages { grid-column: 1 / -1; } }
  .tiles { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); margin-bottom: 2.5rem; }
  .tile { display: grid; gap: 0.35rem; padding: 1.25rem; border: 1px solid var(--line); background: var(--surface); }
  .tile .mono { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .tile strong { font-family: var(--font-display); font-size: 2.6rem; font-weight: 400; line-height: 1; }
  .tile span:last-child { font-size: 0.85rem; color: var(--muted, #9b978f); }
  @media (max-width: 600px) { .tile strong { font-size: 2.1rem; } }
  /* Phone layout: compact, most important first, nothing to scroll sideways. */
  @media (max-width: 600px) {
    .hero-wrap :global(.page-hero) { padding: 1.5rem 0 0.5rem; border: 0; }
    .hero-wrap :global(.page-hero h1) { font-size: 2.4rem; margin: 0; }
    .hero-wrap :global(.page-hero .lead) { display: none; }
    .stats { margin-top: -1.5rem; }
    .stats .sec { font-size: 1.35rem; margin: 1.75rem 0 0.6rem; }
    .tiles { grid-template-columns: 1fr 1fr 1fr; gap: 0.4rem; margin-bottom: 0; }
    .tile { padding: 0.75rem 0.6rem; gap: 0.25rem; }
    .tile .mono { font-size: 0.55rem; letter-spacing: 0.08em; }
    .tile strong { font-size: 1.35rem; }
    .tile span:last-child { font-size: 0.68rem; line-height: 1.3; }
    .followers, .site-visits { margin-bottom: 0; }
    .v-grid { gap: 0.4rem; }
    .v-tile { padding: 0.8rem 0.85rem; }
    .v-tile strong { font-size: 1.8rem; }
    .site-visits .h3 { flex-wrap: wrap; row-gap: 0.2rem; }
                }
</style>
