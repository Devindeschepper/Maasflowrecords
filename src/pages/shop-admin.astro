---
// Private shop page for VIN: what to do (orders to ship, stock running out), sales, stock and countries.
// Same password as /studio-stats/ (remembered in this browser). Not linked publicly and not indexed.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Shop orders" description="Private shop page." noindex noFooter>
  <section class="section">
    <div class="container">
      <form class="unlock" data-unlock hidden>
        <span class="door-sign" aria-hidden="true">Shop</span>
        <p class="kicker mono">Private</p>
        <h1>Shop</h1>
        <p class="muted">Orders, sales and stock.</p>
        <label class="sr-only" for="shop-token">Password</label>
        <input id="shop-token" type="password" autocomplete="current-password" placeholder="Password" required />
        <button class="btn btn-primary" type="submit">Open shop</button>
        <p class="error" data-error hidden></p>
      </form>

      <div class="panel" data-panel hidden>
        <div class="top">
          <div class="links"><a class="back mono" href="/studio-stats/">← Studio stats</a><a class="back mono" href="/admin/">Edit website (admin) →</a></div>
          <h1>Shop <span class="status mono" data-status></span></h1>
        </div>

        <section class="controls" data-controls hidden>
          <div class="ctrl">
            <div><b>Shop</b><span class="muted" data-c-open-text></span></div>
            <button class="btn small" type="button" data-c-open></button>
          </div>
          <div class="ctrl">
            <div><b>Test mode</b><span class="muted" data-c-test-text></span></div>
            <button class="btn btn-ghost small" type="button" data-c-test></button>
          </div>
          <div class="ctrl" data-c-drop-row>
            <div><b>Timed drop</b><span class="muted" data-c-drop-text></span></div>
            <div class="drop-set" data-c-drop-set>
              <label class="sr-only" for="c-drop">Drop date and time</label>
              <input id="c-drop" type="datetime-local" data-c-drop-input />
              <button class="btn btn-primary small" type="button" data-c-drop>Plan drop</button>
            </div>
            <button class="btn btn-ghost small" type="button" data-c-drop-cancel hidden>Cancel drop</button>
          </div>
          <p class="c-msg" data-c-msg hidden></p>
        </section>
        <p class="c-setup muted" data-c-setup hidden>To open the shop and add products from this page, one setup step is still needed (a GitHub key in Cloudflare). Ask Claude for the steps.</p>

        <h2 class="h3 sec">To do</h2>
        <ul class="todo" data-todo></ul>

        <section data-ship-box>
          <div class="sec-row">
            <h2 class="h3 sec">Orders to ship <span class="count mono" data-ship-count></span></h2>
            <button class="btn btn-ghost small" type="button" data-export>Packing list (Excel)</button>
          </div>
          <ol class="orders" data-to-ship></ol>
        </section>

        <h2 class="h3 sec">Sales</h2>
        <div class="tiles">
          <div class="tile"><span class="mono muted">This month</span><strong data-k="month"></strong><span data-k="month-meta"></span></div>
          <div class="tile"><span class="mono muted">Best seller</span><strong data-k="best"></strong><span data-k="best-meta"></span></div>
          <div class="tile"><span class="mono muted">All time</span><strong data-k="all"></strong><span data-k="all-meta"></span></div>
        </div>

        <h2 class="h3 sec">Stock</h2>
        <ul class="stock" data-stock></ul>

        <section data-products-box hidden>
          <div class="sec-row">
            <h2 class="h3 sec">Products</h2>
            <button class="btn btn-primary small" type="button" data-p-add>+ Add product</button>
          </div>
          <ul class="plist" data-plist></ul>
          <form class="pform" data-pform hidden>
            <h3 data-pf-title>New product</h3>
            <label>Name<input name="name" required maxlength="80" placeholder="e.g. MFR chain" /></label>
            <div class="pf-row">
              <label>Category<select name="category" data-pf-cat></select></label>
              <label>Price (€)<input name="price" type="number" min="0.01" step="0.01" required placeholder="24.90" /></label>
              <label>How many you have<input name="stock" type="number" min="0" step="1" required placeholder="20" /></label>
            </div>
            <label>Description<textarea name="description" rows="3" maxlength="1000" placeholder="Material, size, what makes it special…"></textarea></label>
            <label>Sizes <span class="muted">(optional, separated by commas: S, M, L or 45 cm, 50 cm)</span><input name="sizes" maxlength="200" /></label>
            <div class="pf-row one">
              <label>Package size<select name="shippingClass"><option value="small">Small (CD, chain, poster)</option><option value="standard">Standard (clothing, vinyl)</option></select></label>
              <label class="check"><input name="preorder" type="checkbox" /> Pre-order (not shipped yet)</label>
            </div>
            <label>Photo <span class="muted" data-pf-photo-note>(square works best)</span><input name="photo" type="file" accept="image/jpeg,image/png,image/webp" /></label>
            <p class="c-msg" data-pf-msg hidden></p>
            <div class="pf-actions">
              <button class="btn btn-ghost small danger" type="button" data-pf-remove hidden>Remove</button>
              <button class="btn btn-ghost small" type="button" data-pf-cancel>Cancel</button>
              <button class="btn btn-primary small" type="submit">Save</button>
            </div>
          </form>
        </section>

        <section data-countries-box hidden>
          <h2 class="h3 sec">Orders by country</h2>
          <ol class="countries" data-countries></ol>
        </section>

        <details class="shipped" data-shipped-box hidden>
          <summary class="mono">Recently shipped</summary>
          <ol class="orders" data-shipped-list></ol>
        </details>

        <button class="btn btn-ghost lock" type="button" data-lock>Forget password on this device</button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  type Order = {
    orderId: string; at: number; via: string; total: number; shippingZone: string; shippedAt: number | null;
    items: { name: string; qty: number; size?: string }[];
    customer: { name: string; email: string; address: string; postalCode: string; city: string; country: string; notes: string } | null;
  };
  type Data = {
    ok: boolean; error?: string;
    stats: {
      open: boolean; drop: string | null; test: boolean;
      month: { orders: number; revenue: number; best: { name: string; qty: number } | null };
      all: { orders: number; revenue: number };
      stock: { id: string; name: string; stock: number; sold: number; left: number; low: boolean }[];
      countries: { name: string; orders: number }[];
    } | null;
    toShip: Order[]; shipped: Order[];
  };

  // Same key as /studio-stats/, so unlocking one page unlocks both.
  const KEY = 'mfr-studio-token';
  const store = {
    get: () => { try { return localStorage.getItem(KEY) ?? ''; } catch { return ''; } },
    set: (v: string) => { try { localStorage.setItem(KEY, v); } catch { /* private mode */ } },
    clear: () => { try { localStorage.removeItem(KEY); } catch { /* private mode */ } },
  };
  const form = document.querySelector<HTMLFormElement>('[data-unlock]')!;
  const input = document.querySelector<HTMLInputElement>('#shop-token')!;
  const error = document.querySelector<HTMLElement>('[data-error]')!;
  const panel = document.querySelector<HTMLElement>('[data-panel]')!;
  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => panel.querySelector<T>(sel)!;

  const esc = (t: unknown) => String(t ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const money = (c: number) => `€${(c / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
  const date = (t: number) => new Date(t).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
  const headers = () => ({ Authorization: `Bearer ${store.get()}`, Accept: 'application/json' });

  function orderCard(o: Order, shipped: boolean): string {
    const c = o.customer;
    const address = c ? [c.name, c.address, `${c.postalCode} ${c.city}`.trim(), c.country].filter(Boolean).join('\n') : 'Address: see the order email';
    return `<li class="order">
      <div class="o-head"><b class="mono">${esc(o.orderId)}</b><span class="muted">${esc(date(o.at))} · ${esc(money(o.total))}</span></div>
      <ul class="o-items">${o.items.map((l) => `<li>${l.qty} × ${esc(l.name)}${l.size ? ` (${esc(l.size)})` : ''}</li>`).join('')}</ul>
      <pre class="o-addr">${esc(address)}</pre>
      ${c?.notes ? `<p class="o-notes">Note: ${esc(c.notes)}</p>` : ''}
      <div class="o-actions">
        ${c?.email ? `<a class="btn btn-ghost small" href="mailto:${esc(c.email)}?subject=${encodeURIComponent(`Your Maas Flow Records order ${o.orderId}`)}">Email</a>` : ''}
        <button class="btn ${shipped ? 'btn-ghost' : 'btn-primary'} small" type="button" data-ship="${esc(o.orderId)}" data-mark="${shipped ? '0' : '1'}">${shipped ? 'Undo' : 'Shipped ✓'}</button>
      </div>
    </li>`;
  }

  let lastData: Data | null = null;
  function render(d: Data) {
    lastData = d;
    const s = d.stats;
    liveOpen = s ? s.open : null;
    const dropSoon = !!s?.drop && Date.parse(s.drop) > Date.now();
    const status = $('[data-status]');
    status.textContent = !s?.open ? 'Closed' : dropSoon ? 'Drop planned' : s.test ? 'Test mode' : 'Online';
    status.className = `status mono ${!s?.open ? 'off' : s.test || dropSoon ? 'test' : 'on'}`;

    // To do: what needs VIN's attention right now, most important first.
    const todo: string[] = [];
    if (d.toShip.length) todo.push(`📦 <b>${plural(d.toShip.length, 'order')} to ship.</b> Pack them, then tap “Shipped ✓”.`);
    for (const p of s?.stock ?? []) {
      const waiting = manage?.waiting?.[p.id] ?? 0;
      if (p.left === 0) todo.push(`❌ <b>${esc(p.name)} is sold out.</b>${waiting ? ` ${plural(waiting, 'person')} want${waiting === 1 ? 's' : ''} an email when it’s back.` : ''} Got more? Tap “Edit” on it under Products and put the new number.`);
      else if (p.low) todo.push(`⚠️ <b>Only ${p.left} × ${esc(p.name)} left.</b> Order more, or post “last copies”.`);
    }
    if (s?.open && s.test) todo.push('🟡 <b>Test mode is on:</b> real payments don’t work. When you’re ready, tap “Turn test mode off” at the top.');
    if (dropSoon) todo.push(`⏳ <b>Drop on ${esc(date(Date.parse(s!.drop!)))}.</b> The shop opens by itself then. Post the countdown on Instagram and TikTok.`);
    if (!s?.open) todo.push('⚪ <b>The shop is closed</b> (coming soon). When you’re ready to sell, tap “Open the shop” or plan a timed drop at the top.');
    if (!todo.length) todo.push('✅ <b>Nothing to do.</b> All orders are shipped and the stock is fine.');
    $('[data-todo]').innerHTML = todo.map((t) => `<li>${t}</li>`).join('');

    // Orders to ship, oldest first (packing order).
    $('[data-ship-count]').textContent = d.toShip.length ? String(d.toShip.length) : '';
    $('[data-to-ship]').innerHTML = d.toShip.length ? d.toShip.map((o) => orderCard(o, false)).join('') : '<li class="empty muted">No orders waiting.</li>';
    $<HTMLButtonElement>('[data-export]').hidden = !d.toShip.length;

    if (s) {
      $('[data-k="month"]').textContent = money(s.month.revenue);
      $('[data-k="month-meta"]').textContent = plural(s.month.orders, 'order');
      $('[data-k="best"]').textContent = s.month.best ? `${s.month.best.qty}×` : '—';
      $('[data-k="best-meta"]').textContent = s.month.best ? s.month.best.name : 'No sales yet this month';
      $('[data-k="all"]').textContent = money(s.all.revenue);
      $('[data-k="all-meta"]').textContent = plural(s.all.orders, 'order');
      $('[data-stock]').innerHTML = s.stock
        .map((p) => `<li class="${p.left === 0 ? 'out' : p.low ? 'low' : ''}"><span>${esc(p.name)}</span><b>${p.left === 0 ? 'Sold out' : `${p.left} left`}</b><small class="muted">${p.sold} sold of ${p.stock}</small></li>`)
        .join('') || '<li class="muted">No products yet.</li>';
      const max = Math.max(1, ...s.countries.map((c) => c.orders));
      $('[data-countries-box]').hidden = !s.countries.length;
      $('[data-countries]').innerHTML = s.countries
        .map((c) => `<li><span>${esc(c.name)}</span><span class="bar"><span style="width:${Math.max(6, (c.orders / max) * 100)}%"></span></span><b>${c.orders}</b></li>`)
        .join('');
    }

    $('[data-shipped-box]').hidden = !d.shipped.length;
    $('[data-shipped-list]').innerHTML = d.shipped.map((o) => orderCard(o, true)).join('');
    panel.querySelectorAll<HTMLButtonElement>('[data-ship]').forEach((b) => b.addEventListener('click', ship));
  }

  async function load(token: string) {
    error.hidden = true;
    store.set(token);
    try {
      const res = await fetch('/api/shop', { headers: headers() });
      const data = (await res.json()) as Data;
      if (!data.ok) throw new Error(data.error ?? 'Could not load the shop.');
      render(data);
      form.hidden = true;
      panel.hidden = false;
      if (!manage) loadManage();
    } catch (err) {
      store.clear();
      panel.hidden = true;
      form.hidden = false;
      error.textContent = err instanceof Error ? err.message : 'Could not load the shop.';
      error.hidden = false;
    }
  }

  async function ship(e: Event) {
    const b = e.currentTarget as HTMLButtonElement;
    b.disabled = true;
    try {
      const res = await fetch('/api/shop/shipped', {
        method: 'POST',
        headers: { ...headers(), 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderId: b.dataset.ship, shipped: b.dataset.mark === '1' }),
      });
      const data = (await res.json()) as { ok: boolean; error?: string };
      if (!data.ok) throw new Error(data.error);
      await load(store.get());
    } catch {
      b.disabled = false;
      b.textContent = 'Try again';
    }
  }

  // Packing list: every order to ship with its address, as an Excel file.
  $('[data-export]').addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    b.disabled = true;
    try {
      const res = await fetch('/api/shop/export', { headers: headers() });
      const data = (await res.json()) as { ok: boolean; filename: string; content: string };
      if (!data.ok) throw new Error();
      const bytes = Uint8Array.from(atob(data.content), (c) => c.charCodeAt(0));
      const url = URL.createObjectURL(new Blob([bytes], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }));
      const a = Object.assign(document.createElement('a'), { href: url, download: data.filename });
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 5000);
    } finally {
      b.disabled = false;
    }
  });

  // ---- Managing the shop: open/close, test mode, products (saved on GitHub, live after ~2 minutes) ----
  type RawProduct = { id: string; name: string; category: string; description?: string; price: number; image: string; stock: number; preorder?: boolean; sizes?: string[]; shippingClass?: string };
  type Manage = { ok: boolean; error?: string; github: boolean; categories?: string[]; shopOpen?: boolean; shopTestMode?: boolean; dropAt?: string | null; products?: RawProduct[]; waiting?: Record<string, number> };
  let manage: Manage | null = null;
  let editing: RawProduct | null = null;
  let liveOpen: boolean | null = null;
  const pform = $<HTMLFormElement>('[data-pform]');
  const LIVE_NOTE = 'Saved ✓ The website updates in about 2 minutes.';

  const say = (el: HTMLElement, text: string, bad = false) => { el.textContent = text; el.classList.toggle('bad', bad); el.hidden = !text; };

  async function post(path: string, body: unknown) {
    const res = await fetch(path, { method: 'POST', headers: { ...headers(), 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = (await res.json().catch(() => ({ ok: false, error: 'Something went wrong.' }))) as { ok: boolean; error?: string };
    if (!data.ok) throw new Error(data.error ?? 'Something went wrong.');
    return data;
  }

  function renderManage() {
    const m = manage;
    $('[data-c-setup]').hidden = !m || m.github;
    $('[data-controls]').hidden = !m?.github;
    $('[data-products-box]').hidden = !m?.github;
    if (!m?.github) return;
    // The live site only changes after the rebuild (~2 min): show that in the status next to the title.
    const status = $('[data-status]');
    const savedOpen = !!m.shopOpen || !!m.dropAt;
    if (liveOpen !== null && savedOpen !== liveOpen) {
      status.textContent = savedOpen ? 'Opening…' : 'Closing…';
      status.className = 'status mono test';
    }
    const open = $<HTMLButtonElement>('[data-c-open]');
    $('[data-c-open-text]').textContent = m.shopOpen ? 'Open: people can buy.' : 'Closed: the shop shows “Coming soon”.';
    open.textContent = m.shopOpen ? 'Close the shop' : 'Open the shop';
    open.className = `btn small ${m.shopOpen ? 'btn-ghost' : 'btn-primary'}`;
    $('[data-c-test-text]').textContent = m.shopTestMode ? 'On: only test payments, no real money.' : 'Off: real payments.';
    $('[data-c-test]').textContent = m.shopTestMode ? 'Turn test mode off' : 'Turn test mode on';
    // Timed drop: only while the shop is closed. The time is typed in this phone's time zone.
    $('[data-c-drop-row]').hidden = !!m.shopOpen;
    $('[data-c-drop-text]').textContent = m.dropAt
      ? `The shop opens by itself on ${date(Date.parse(m.dropAt))}. Until then, people see a countdown.`
      : 'Pick a day and time: the shop opens by itself, with a countdown before.';
    $('[data-c-drop-set]').hidden = !!m.dropAt;
    $('[data-c-drop-cancel]').hidden = !m.dropAt;
    const waiting = (id: string) => m.waiting?.[id] ? ` · ${m.waiting[id]} waiting` : '';
    $('[data-pf-cat]').innerHTML = (m.categories ?? []).map((c) => `<option>${esc(c)}</option>`).join('');
    $('[data-plist]').innerHTML = (m.products ?? []).length
      ? m.products!.map((p) => `<li><img src="${esc(p.image)}" alt="" loading="lazy" /><span><b>${esc(p.name)}</b><small class="muted">${esc(p.category)} · €${Number(p.price).toFixed(2)} · ${p.stock} in stock${p.preorder ? ' · pre-order' : ''}${waiting(p.id)}</small></span><button class="btn btn-ghost small" type="button" data-p-edit="${esc(p.id)}">Edit</button></li>`).join('')
      : '<li class="muted">No products yet.</li>';
    panel.querySelectorAll<HTMLButtonElement>('[data-p-edit]').forEach((b) => b.addEventListener('click', () => openForm(m.products!.find((p) => p.id === b.dataset.pEdit) ?? null)));
  }

  async function loadManage() {
    try {
      const res = await fetch('/api/shop/manage', { headers: headers() });
      manage = (await res.json()) as Manage;
      if (!manage.ok) throw new Error(manage.error);
    } catch (err) {
      manage = { ok: false, github: true };
      say($('[data-c-msg]'), err instanceof Error && err.message ? err.message : "Couldn't load the shop settings.", true);
      $('[data-controls]').hidden = false;
      return;
    }
    if (lastData) render(lastData); // the to-do list also shows who waits for sold-out products
    renderManage();
  }

  async function toggle(btn: HTMLButtonElement, body: { shopOpen?: boolean; shopTestMode?: boolean; dropAt?: string | null }) {
    const msg = $('[data-c-msg]');
    btn.disabled = true;
    say(msg, 'Saving…');
    try {
      const data = (await post('/api/shop/settings', body)) as unknown as { shopOpen: boolean; shopTestMode: boolean; dropAt: string | null };
      manage = { ...manage!, shopOpen: data.shopOpen, shopTestMode: data.shopTestMode, dropAt: data.dropAt };
      renderManage();
      say(msg, LIVE_NOTE);
    } catch (err) {
      say(msg, err instanceof Error ? err.message : 'Could not save.', true);
    } finally {
      btn.disabled = false;
    }
  }
  $('[data-c-open]').addEventListener('click', (e) => {
    const opening = !manage?.shopOpen;
    if (opening && !confirm(manage?.shopTestMode ? 'Open the shop in test mode?' : 'Open the shop for real? People will be able to buy and pay.')) return;
    toggle(e.currentTarget as HTMLButtonElement, { shopOpen: opening });
  });
  $('[data-c-test]').addEventListener('click', (e) => toggle(e.currentTarget as HTMLButtonElement, { shopTestMode: !manage?.shopTestMode }));
  $('[data-c-drop]').addEventListener('click', (e) => {
    const value = $<HTMLInputElement>('[data-c-drop-input]').value;
    if (!value) return say($('[data-c-msg]'), 'Pick a day and time first.', true);
    const at = new Date(value); // datetime-local = this phone's time zone
    if (!confirm(`Plan the drop for ${date(at.getTime())}? The shop opens by itself then${manage?.shopTestMode ? ' (in test mode)' : ''}.`)) return;
    toggle(e.currentTarget as HTMLButtonElement, { dropAt: at.toISOString() });
  });
  $('[data-c-drop-cancel]').addEventListener('click', (e) => {
    if (confirm('Cancel the drop? The shop goes back to “Coming soon”.')) toggle(e.currentTarget as HTMLButtonElement, { dropAt: null });
  });

  function openForm(p: RawProduct | null) {
    editing = p;
    pform.reset();
    say($('[data-pf-msg]'), '');
    $('[data-pf-title]').textContent = p ? `Edit: ${p.name}` : 'New product';
    $('[data-pf-remove]').hidden = !p;
    $('[data-pf-photo-note]').textContent = p ? '(leave empty to keep the current photo)' : '(square works best)';
    if (p) {
      const f = pform.elements as unknown as Record<string, HTMLInputElement>;
      f.name.value = p.name; f.category.value = p.category; f.price.value = String(p.price); f.stock.value = String(p.stock);
      f.description.value = p.description ?? ''; f.sizes.value = (p.sizes ?? []).join(', ');
      f.shippingClass.value = p.shippingClass === 'standard' ? 'standard' : 'small'; f.preorder.checked = !!p.preorder;
    }
    pform.hidden = false;
    pform.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  $('[data-p-add]').addEventListener('click', () => openForm(null));
  $('[data-pf-cancel]').addEventListener('click', () => { pform.hidden = true; });

  // Phone photos are big: make them at most 1600 px wide as a JPG before sending.
  async function photoData(file: File): Promise<{ type: string; data: string }> {
    const bmp = await createImageBitmap(file);
    const scale = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
    const canvas = Object.assign(document.createElement('canvas'), { width: Math.round(bmp.width * scale), height: Math.round(bmp.height * scale) });
    canvas.getContext('2d')!.drawImage(bmp, 0, 0, canvas.width, canvas.height);
    const blob = await new Promise<Blob>((ok) => canvas.toBlob((b) => ok(b!), 'image/jpeg', 0.85));
    const bytes = new Uint8Array(await blob.arrayBuffer());
    let bin = '';
    for (let i = 0; i < bytes.length; i += 0x8000) bin += String.fromCharCode(...bytes.subarray(i, i + 0x8000));
    return { type: 'image/jpeg', data: btoa(bin) };
  }

  pform.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = pform.elements as unknown as Record<string, HTMLInputElement>;
    const msg = $('[data-pf-msg]');
    const save = pform.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    save.disabled = true;
    say(msg, 'Saving…');
    try {
      const file = f.photo.files?.[0];
      await post('/api/shop/products', {
        action: 'save',
        product: {
          isNew: !editing, id: editing?.id, name: f.name.value, category: f.category.value, price: Number(f.price.value), stock: Number(f.stock.value),
          description: f.description.value, sizes: f.sizes.value.split(',').map((x) => x.trim()).filter(Boolean),
          shippingClass: f.shippingClass.value, preorder: f.preorder.checked,
        },
        image: file ? await photoData(file) : undefined,
      });
      pform.hidden = true;
      say($('[data-c-msg]'), LIVE_NOTE);
      await loadManage();
    } catch (err) {
      say(msg, err instanceof Error ? err.message : 'Could not save.', true);
    } finally {
      save.disabled = false;
    }
  });
  $('[data-pf-remove]').addEventListener('click', async () => {
    if (!editing || !confirm(`Remove “${editing.name}” from the shop?`)) return;
    try {
      await post('/api/shop/products', { action: 'remove', id: editing.id });
      pform.hidden = true;
      say($('[data-c-msg]'), LIVE_NOTE);
      await loadManage();
    } catch (err) {
      say($('[data-pf-msg]'), err instanceof Error ? err.message : 'Could not remove.', true);
    }
  });

  form.addEventListener('submit', (e) => { e.preventDefault(); load(input.value.trim()); });
  $('[data-lock]').addEventListener('click', () => { store.clear(); location.reload(); });
  const saved = store.get();
  if (saved) load(saved);
  else form.hidden = false;
</script>

