---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Turnstile from '../components/Turnstile.astro';
import ShopComingSoon from '../components/ShopComingSoon.astro';
import TestModeBanner from '../components/TestModeBanner.astro';
import { products, orderableZones, MAX_QTY_PER_ITEM } from '../data/products';
import { vat } from '../data/vat';
import { shopOpen, shopTestMode, paymentMethods } from '../data/site';

const online = paymentMethods.card || paymentMethods.crypto;

// Only what the browser needs to display the cart. The server re-prices everything.
const catalogue = products.map(({ id, name, price, image, stock, preorder, shippingClass }) => ({
  id, name, price, image, stock, preorder, shippingClass,
}));
---

<BaseLayout title="Cart & Checkout" description="Your Maas Flow Records shopping cart." noindex>
  <PageHero eyebrow="Shop" title="Cart" />

  {!shopOpen && <ShopComingSoon />}
  {shopOpen && shopTestMode && <TestModeBanner />}
  {shopOpen && (<>
  <script type="application/json" id="catalogue" set:html={JSON.stringify({ catalogue, zones: orderableZones, vat, max: MAX_QTY_PER_ITEM }).replace(/</g, '\\u003c')} />

  <section class="section">
    <div class="container checkout">
      <div>
        <h2 class="sr-only">Items</h2>
        <ul class="lines" id="cart-lines" aria-live="polite"></ul>
        <p class="empty" id="cart-empty" hidden>Your cart is empty. <a href="/shop/">Go to the shop</a>.</p>
      </div>

      <aside class="summary card" id="checkout-box" hidden>
        <h2 class="h3">Checkout</h2>
        <p class="notice" id="pay-cancelled" hidden>Payment cancelled - nothing was charged. You can try again.</p>
        <form class="form" id="checkout-form" action="/api/checkout" method="post">
          {orderableZones.length === 0 && <p class="notice">Shipping prices are coming soon - orders open shortly.</p>}
          <div class="field">
            <label for="o-zone">Ship to <span class="req">*</span></label>
            <select id="o-zone" name="zone" required>
              {orderableZones.map((z) => <option value={z.id}>{z.label}</option>)}
            </select>
          </div>

          <dl class="totals">
            <div><dt>Subtotal</dt><dd id="t-sub">-</dd></div>
            <div><dt>Shipping</dt><dd id="t-ship">-</dd></div>
            <div class="grand"><dt>Total</dt><dd id="t-total">-</dd></div>
            <div class="vat"><dt id="t-vat-note">-</dt><dd id="t-vat"></dd></div>
          </dl>

          <fieldset class="fs">
            <legend>Your details</legend>
            <div class="field"><label for="o-name">Full name <span class="req">*</span></label><input id="o-name" name="name" required maxlength="100" autocomplete="name" /></div>
            <div class="field"><label for="o-email">Email <span class="req">*</span></label><input id="o-email" name="email" type="email" required maxlength="200" autocomplete="email" /></div>
            <div class="field"><label for="o-addr">Address <span class="req">*</span></label><input id="o-addr" name="address" required maxlength="200" autocomplete="street-address" /></div>
            <div class="form-row">
              <div class="field"><label for="o-zip">Postal code <span class="req">*</span></label><input id="o-zip" name="postalCode" required maxlength="20" autocomplete="postal-code" /></div>
              <div class="field"><label for="o-city">City <span class="req">*</span></label><input id="o-city" name="city" required maxlength="100" autocomplete="address-level2" /></div>
            </div>
            <div class="field"><label for="o-country">Country <span class="req">*</span></label><input id="o-country" name="country" required maxlength="80" autocomplete="country-name" /></div>
            <div class="field"><label for="o-notes">Order notes</label><textarea id="o-notes" name="notes" class="short" maxlength="1000" rows="3"></textarea></div>
          </fieldset>

          {online && (
            <fieldset class="fs pay">
              <legend>Payment</legend>
              {paymentMethods.card && (
                <label class="opt">
                  <input type="radio" name="method" value="card" required checked />
                  <span><strong>Card or PayPal</strong><small class="muted">Also Apple Pay / Google Pay · secure checkout by Stripe</small></span>
                </label>
              )}
              {paymentMethods.crypto && (
                <label class="opt">
                  <input type="radio" name="method" value="crypto" required checked={!paymentMethods.card} />
                  <span><strong>Crypto</strong><small class="muted">Bitcoin, Ethereum, USDT and more · via NOWPayments</small></span>
                </label>
              )}
            </fieldset>
          )}

          <div class="hp" aria-hidden="true"><label for="o-website">Website</label><input id="o-website" name="website" tabindex="-1" autocomplete="off" /></div>
          <input type="hidden" name="_ts" value="" />
          <input type="hidden" name="cart" value="" />

          <label class="check">
            <input type="checkbox" name="terms" value="yes" required />
            <span>I agree to the <a href="/shop/#shipping">shipping &amp; returns</a> terms.</span>
          </label>

          <Turnstile />
          <button class="btn btn-primary" type="submit">{online ? 'Continue to payment' : 'Place order'}</button>
          {online && <p class="muted fine">You'll be sent to a secure payment page. Payment details never touch this website.</p>}
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </aside>

      <div class="card done" id="order-done" hidden>
        <h2>Thank you</h2>
        <p class="lead" id="order-done-msg"></p>
        <a class="btn" href="/shop/">Back to shop</a>
      </div>
    </div>
  </section>
  </>)}
</BaseLayout>

<script>
  import { getCart, setQty, clearCart, onCartChange } from '../scripts/cart';

  const catalogueEl = document.getElementById('catalogue');
  if (catalogueEl) initCart(catalogueEl);

  function initCart(catalogueEl: HTMLElement) {

  type Item = { id: string; name: string; price: number; image: string; stock: number; preorder?: boolean; shippingClass: 'small' | 'standard' };
  type Zone = { id: string; label: string; price: number; estimate: string; inEU: boolean };
  const { catalogue, zones, vat, max } = JSON.parse(catalogueEl.textContent!) as {
    catalogue: Item[]; zones: Zone[]; vat: { mode: 'included' | 'exempt'; rate: number }; max: number;
  };
  // Same rules as src/data/vat.ts (the server recalculates everything at checkout).
  const exVat = (gross: number) => Math.round((gross * 100) / (100 + vat.rate));
  const forZone = (gross: number, z: Zone) => (vat.mode === 'included' && !z.inEU ? exVat(gross) : gross);

  const eur = (c: number) => new Intl.NumberFormat('en-IE', { style: 'currency', currency: 'EUR' }).format(c / 100);
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const list = $<HTMLUListElement>('cart-lines');
  const form = $<HTMLFormElement>('checkout-form');
  const zoneSel = $<HTMLSelectElement>('o-zone');
  const status = form.querySelector<HTMLElement>('.form-status')!;
  (form.elements.namedItem('_ts') as HTMLInputElement).value = String(Date.now());

  const el = (tag: string, cls?: string, text?: string) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  };

  function lines() {
    return getCart()
      .map((l) => ({ ...l, item: catalogue.find((p) => p.id === l.id) }))
      .filter((l): l is typeof l & { item: Item } => !!l.item && l.item.stock > 0);
  }

  function render() {
    const ls = lines();
    list.replaceChildren();
    $('cart-empty').hidden = ls.length > 0;
    $('checkout-box').hidden = ls.length === 0;

    for (const l of ls) {
      const li = el('li', 'line');
      const img = el('img') as HTMLImageElement;
      img.src = l.item.image; img.alt = ''; img.width = 96; img.height = 96;
      const info = el('div', 'line-info');
      info.append(el('strong', '', l.item.name));
      if (l.size) info.append(el('span', 'mono muted', `Size: ${l.size}`));
      if (l.item.preorder) info.append(el('span', 'tag tag-accent', 'Pre-order'));
      info.append(el('span', 'muted', eur(l.item.price)));

      const qty = el('div', 'qty');
      const label = `${l.item.name}${l.size ? ` (${l.size})` : ''}`;
      const cap = Math.min(max, l.item.stock);
      const minus = el('button', 'qbtn', '−') as HTMLButtonElement;
      minus.type = 'button'; minus.setAttribute('aria-label', `Decrease quantity of ${label}`);
      minus.onclick = () => setQty(l.id, l.size, l.qty - 1, cap);
      const n = el('span', 'qn', String(l.qty));
      n.setAttribute('aria-label', `Quantity ${l.qty}`);
      const plus = el('button', 'qbtn', '+') as HTMLButtonElement;
      plus.type = 'button'; plus.setAttribute('aria-label', `Increase quantity of ${label}`);
      plus.disabled = l.qty >= cap;
      plus.onclick = () => setQty(l.id, l.size, l.qty + 1, cap);
      const rm = el('button', 'rm', 'Remove') as HTMLButtonElement;
      rm.type = 'button'; rm.setAttribute('aria-label', `Remove ${label}`);
      rm.onclick = () => setQty(l.id, l.size, 0);
      qty.append(minus, n, plus, rm);

      li.append(img, info, qty, el('span', 'line-total', eur(l.item.price * l.qty)));
      list.append(li);
    }
    totals(ls);
  }

  function totals(ls = lines()) {
    const zone = zones.find((z) => z.id === zoneSel.value) ?? zones[0];
    if (!zone) return;
    const sub = ls.reduce((s, l) => s + forZone(l.item.price, zone) * l.qty, 0);
    const ship = ls.length ? forZone(zone.price, zone) : 0;
    const total = sub + ship;
    $('t-sub').textContent = eur(sub);
    $('t-ship').textContent = `${eur(ship)} · ${zone.estimate}`;
    $('t-total').textContent = eur(total);
    const included = vat.mode === 'included' && zone.inEU;
    $('t-vat-note').textContent =
      vat.mode === 'exempt' ? 'No VAT charged (small business exemption)'
      : zone.inEU ? `Incl. ${vat.rate}% VAT` : 'No EU VAT (export). Import taxes may apply in your country.';
    $('t-vat').textContent = included ? eur(total - exVat(total)) : '';
  }

  if (new URLSearchParams(location.search).get('payment') === 'cancelled') $('pay-cancelled').hidden = false;

  zoneSel.addEventListener('change', () => totals());
  onCartChange(render);
  render();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const cart = lines().map(({ id, size, qty }) => ({ id, size, qty }));
    (form.elements.namedItem('cart') as HTMLInputElement).value = JSON.stringify(cart);
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    btn.disabled = true;
    status.dataset.state = '';
    status.textContent = form.querySelector('input[name="method"]') ? 'Opening the payment page…' : 'Placing order…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string; redirectUrl?: string; message?: string };
      if (!res.ok || !data.ok) throw new Error(data.error || 'Checkout failed. Please try again.');
      if (data.redirectUrl) {
        // Hosted payment page (Stripe / NOWPayments). The cart is cleared on /order/ after paying.
        location.href = data.redirectUrl;
        return;
      }
      clearCart();
      $('checkout-box').hidden = true;
      $('order-done').hidden = false;
      $('order-done-msg').textContent = data.message ?? 'Your order was received.';
    } catch (err) {
      status.dataset.state = 'error';
      status.textContent = `${(err as Error).message} Questions: ${['info', 'maasflowrecords.com'].join('@')}`;
    } finally {
      btn.disabled = false;
      (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
    }
  });
  }
</script>

<style>
  .checkout { display: grid; gap: 2rem; align-items: start; }
  .lines { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .lines :global(.line) {
    display: grid; grid-template-columns: 72px 1fr auto; gap: 0.5rem 1rem; align-items: center;
    padding: 1rem 0; border-bottom: 1px solid var(--line);
  }
  .lines :global(img) { width: 72px; height: 72px; object-fit: cover; background: var(--surface); grid-row: span 2; }
  .lines :global(.line-info) { display: grid; gap: 0.2rem; font-size: 0.92rem; justify-items: start; }
  .lines :global(.line-total) { font-weight: 600; grid-column: 3; grid-row: 1; }
  .lines :global(.qty) { grid-column: 2 / -1; display: flex; align-items: center; gap: 0.25rem; }
  .lines :global(.qbtn) { width: 40px; height: 40px; background: var(--surface); color: var(--text); border: 1px solid var(--line); font-size: 1.1rem; cursor: pointer; }
  .lines :global(.qbtn:disabled) { opacity: 0.4; cursor: not-allowed; }
  .lines :global(.qn) { min-width: 2.2rem; text-align: center; }
  .lines :global(.rm) { margin-left: auto; background: none; border: 0; color: var(--muted); text-decoration: underline; cursor: pointer; font-size: 0.82rem; min-height: 40px; }
  .summary, .done { padding: clamp(1.1rem, 4vw, 1.75rem); }
  .h3 { font-size: clamp(1.35rem, 3vw, 1.75rem); }
  .totals { margin: 0; display: grid; gap: 0.5rem; padding: 1rem 0; border-block: 1px solid var(--line); }
  .totals div { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.92rem; }
  .totals dd { margin: 0; text-align: right; }
  .totals .grand { font-weight: 700; font-size: 1.05rem; }
  .totals .vat { font-size: 0.8rem; color: var(--muted); margin-top: -0.25rem; }
  .fs { border: 0; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .pay { gap: 0.6rem; }
  .opt { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.85rem 1rem; border: 1px solid var(--line); cursor: pointer; }
  .opt:has(input:checked) { border-color: var(--text); background: var(--surface-2); }
  .opt input { margin-top: 0.2rem; accent-color: var(--accent); width: 18px; height: 18px; flex: none; }
  .opt span { display: grid; gap: 0.15rem; }
  .opt small { font-size: 0.8rem; }
  .fine { font-size: 0.8rem; margin: 0; }
  .notice { border-left: 3px solid var(--accent); padding: 0.6rem 0.8rem; background: var(--surface-2); font-size: 0.9rem; }
  .fs legend { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.75rem; }
  @media (min-width: 960px) {
    .checkout { grid-template-columns: 1.5fr 1fr; gap: 3rem; }
    .summary { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  }
</style>
