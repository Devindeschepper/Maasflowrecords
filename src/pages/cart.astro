---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Turnstile from '../components/Turnstile.astro';
import ShopComingSoon from '../components/ShopComingSoon.astro';
import TestModeBanner from '../components/TestModeBanner.astro';
import { products, orderableZones, MAX_QTY_PER_ITEM } from '../data/products';
import { vat } from '../data/vat';
import { shopOpen, dropAt, shopTestMode, paymentMethods } from '../data/site';
import { getLang, localize, pick } from '../i18n';
import { ui } from '../i18n/ui';
import { COUNTRY_CODES, countryLabel, zoneIdFor } from '../data/countries';
import { LOCALES } from '../i18n';

const online = paymentMethods.card || paymentMethods.crypto;
const lang = getLang(Astro);
const L = (href: string) => localize(href, lang);
// Only what the cart needs to work out shipping; zone names stay out of the page.
const zones = orderableZones.map(({ id, price, inEU }) => ({ id, price, inEU }));
// Countries in the page's language, A-Z; those we can't ship to yet can't be picked.
const countries = COUNTRY_CODES.map((code) => ({ code, name: countryLabel(code, LOCALES[lang]), ok: zones.some((z) => z.id === zoneIdFor(code)) }))
  .sort((a, b) => a.name.localeCompare(b.name, LOCALES[lang]));
const t = pick(lang, {
  en: {
    title: 'Cart & Checkout', desc: 'Your Maas Flow Records shopping cart.', eyebrow: 'Shop', h1: 'Cart', items: 'Items', empty: 'Your cart is empty.', goShop: 'Go to the shop',
    checkout: 'Checkout', cancelled: 'Payment cancelled - nothing was charged. You can try again.', noShipping: 'Shipping prices are coming soon - orders open shortly.',
    shipTo: 'Country', chooseCountry: 'Choose your country…', notYet: 'no shipping yet', pickCountry: 'Choose your country', code: 'Discount code', apply: 'Apply', discount: 'Discount', subtotal: 'Subtotal', shipping: 'Shipping', total: 'Total',
    details: 'Your details', name: 'Full name', email: 'Email', address: 'Address', zip: 'Postal code', city: 'City', country: 'Country', notes: 'Order notes',
    payment: 'Payment', card: 'Card, PayPal, Apple Pay, Google Pay', cardSub: 'Secure payment by Stripe · Apple Pay and Google Pay show up on phones that have them', crypto: 'Crypto', cryptoSub: 'Bitcoin, Ethereum, USDT and more · via NOWPayments',
    agree: 'I agree to the', terms: 'shipping & returns', terms2: 'terms.', pay: 'Continue to payment', place: 'Place order', secure: "You'll be sent to a secure payment page. Payment details never touch this website.",
    thanks: 'Thank you', back: 'Back to shop',
  },
  fr: {
    title: 'Panier & paiement', desc: 'Ton panier Maas Flow Records.', eyebrow: 'Boutique', h1: 'Panier', items: 'Articles', empty: 'Ton panier est vide.', goShop: 'Aller à la boutique',
    checkout: 'Commande', cancelled: "Paiement annulé - rien n'a été débité. Tu peux réessayer.", noShipping: 'Les frais de livraison arrivent bientôt - les commandes ouvrent sous peu.',
    shipTo: 'Pays', chooseCountry: 'Choisis ton pays…', notYet: 'pas encore de livraison', pickCountry: 'Choisis ton pays', code: 'Code de réduction', apply: 'Appliquer', discount: 'Réduction', subtotal: 'Sous-total', shipping: 'Livraison', total: 'Total',
    details: 'Tes coordonnées', name: 'Nom complet', email: 'E-mail', address: 'Adresse', zip: 'Code postal', city: 'Ville', country: 'Pays', notes: 'Remarques sur la commande',
    payment: 'Paiement', card: 'Carte, PayPal, Apple Pay, Google Pay', cardSub: 'Paiement sécurisé par Stripe · Apple Pay et Google Pay apparaissent sur les téléphones qui les ont', crypto: 'Crypto', cryptoSub: 'Bitcoin, Ethereum, USDT et plus · via NOWPayments',
    agree: "J'accepte les conditions de", terms: 'livraison & retours', terms2: '.', pay: 'Continuer vers le paiement', place: 'Passer la commande', secure: 'Tu seras redirigé vers une page de paiement sécurisée. Tes données de paiement ne passent jamais par ce site.',
    thanks: 'Merci', back: 'Retour à la boutique',
  },
  de: {
    title: 'Warenkorb & Kasse', desc: 'Dein Maas Flow Records Warenkorb.', eyebrow: 'Shop', h1: 'Warenkorb', items: 'Artikel', empty: 'Dein Warenkorb ist leer.', goShop: 'Zum Shop',
    checkout: 'Kasse', cancelled: 'Zahlung abgebrochen - es wurde nichts abgebucht. Du kannst es nochmal versuchen.', noShipping: 'Die Versandkosten kommen bald - Bestellungen sind in Kürze möglich.',
    shipTo: 'Land', chooseCountry: 'Wähle dein Land…', notYet: 'noch kein Versand', pickCountry: 'Wähle dein Land', code: 'Rabattcode', apply: 'Einlösen', discount: 'Rabatt', subtotal: 'Zwischensumme', shipping: 'Versand', total: 'Gesamt',
    details: 'Deine Daten', name: 'Vollständiger Name', email: 'E-Mail', address: 'Adresse', zip: 'Postleitzahl', city: 'Stadt', country: 'Land', notes: 'Anmerkungen zur Bestellung',
    payment: 'Bezahlung', card: 'Karte, PayPal, Apple Pay, Google Pay', cardSub: 'Sichere Zahlung über Stripe · Apple Pay und Google Pay erscheinen auf Handys, die sie haben', crypto: 'Krypto', cryptoSub: 'Bitcoin, Ethereum, USDT und mehr · über NOWPayments',
    agree: 'Ich akzeptiere die', terms: 'Versand- & Rückgabebedingungen', terms2: '.', pay: 'Weiter zur Zahlung', place: 'Bestellung absenden', secure: 'Du wirst zu einer sicheren Zahlungsseite weitergeleitet. Deine Zahlungsdaten laufen nie über diese Website.',
    thanks: 'Danke', back: 'Zurück zum Shop',
  },
});

// Only what the browser needs to display the cart. The server re-prices everything.
const catalogue = products.map(({ id, name, price, image, stock, sizeStock, preorder, shippingClass }) => ({
  id, name, price, image, stock, sizeStock, preorder, shippingClass,
}));
---

<BaseLayout title={t.title} description={t.desc} noindex>
  <PageHero eyebrow={t.eyebrow} title={t.h1} />

  {!shopOpen && <ShopComingSoon />}
  {dropAt && <ShopComingSoon dropAt={dropAt} />}
  {shopOpen && (<div data-drop-content hidden={dropAt ? true : undefined}>
  {shopTestMode && <TestModeBanner />}
  <script type="application/json" id="catalogue" set:html={JSON.stringify({ catalogue, zones, vat, max: MAX_QTY_PER_ITEM }).replace(/</g, '\\u003c')} />

  <section class="section">
    <div class="container checkout">
      <div>
        <h2 class="sr-only">{t.items}</h2>
        <ul class="lines" id="cart-lines" aria-live="polite"></ul>
        <p class="empty" id="cart-empty" hidden>{t.empty} <a href={L('/shop/')}>{t.goShop}</a>.</p>
      </div>

      <aside class="summary card" id="checkout-box" hidden>
        <h2 class="h3">{t.checkout}</h2>
        <p class="notice" id="pay-cancelled" hidden>{t.cancelled}</p>
        <form class="form" id="checkout-form" action="/api/checkout" method="post">
          <input type="hidden" name="lang" value={lang} />
          {zones.length === 0 && <p class="notice">{t.noShipping}</p>}


          <fieldset class="fs">
            <legend>{t.details}</legend>
            <div class="field"><label for="o-name">{t.name} <span class="req">*</span></label><input id="o-name" name="name" required maxlength="100" autocomplete="name" /></div>
            <div class="field"><label for="o-email">{t.email} <span class="req">*</span></label><input id="o-email" name="email" type="email" required maxlength="200" autocomplete="email" /></div>
            <div class="field"><label for="o-addr">{t.address} <span class="req">*</span></label><input id="o-addr" name="address" required maxlength="200" autocomplete="street-address" /></div>
            <div class="form-row">
              <div class="field"><label for="o-zip">{t.zip} <span class="req">*</span></label><input id="o-zip" name="postalCode" required maxlength="20" autocomplete="postal-code" /></div>
              <div class="field"><label for="o-city">{t.city} <span class="req">*</span></label><input id="o-city" name="city" required maxlength="100" autocomplete="address-level2" /></div>
            </div>
            <div class="field">
              <label for="o-country">{t.country} <span class="req">*</span></label>
              <select id="o-country" name="country" required autocomplete="country" data-pick-country={t.pickCountry}>
                <option value="">{t.chooseCountry}</option>
                {countries.map((c) => <option value={c.code} disabled={!c.ok}>{c.ok ? c.name : `${c.name} (${t.notYet})`}</option>)}
              </select>
            </div>
          </fieldset>

          {online && (
            <fieldset class="fs pay">
              <legend>{t.payment}</legend>
              {paymentMethods.card && (
                <label class="opt">
                  <input type="radio" name="method" value="card" required checked />
                  <span><strong>{t.card}</strong><small class="muted">{t.cardSub}</small></span>
                </label>
              )}
              {paymentMethods.crypto && (
                <label class="opt">
                  <input type="radio" name="method" value="crypto" required checked={!paymentMethods.card} />
                  <span><strong>{t.crypto}</strong><small class="muted">{t.cryptoSub}</small></span>
                </label>
              )}
            </fieldset>
          )}

          <div class="field">
            <label for="o-code">{t.code}</label>
            <div class="code-row">
              <input id="o-code" name="discount" maxlength="40" autocomplete="off" autocapitalize="characters" spellcheck="false" />
              <button class="btn btn-ghost" type="button" id="o-code-apply">{t.apply}</button>
            </div>
            <p class="code-msg" id="o-code-msg" role="status" aria-live="polite"></p>
          </div>

          <dl class="totals">
            <div class="disc" id="t-disc-row" hidden><dt id="t-disc-label">{t.discount}</dt><dd id="t-disc">-</dd></div>
            <div><dt>{t.subtotal}</dt><dd id="t-sub">-</dd></div>
            <div><dt>{t.shipping}</dt><dd id="t-ship">-</dd></div>
            <div class="grand"><dt>{t.total}</dt><dd id="t-total">-</dd></div>
            <div class="vat"><dt id="t-vat-note">-</dt><dd id="t-vat"></dd></div>
          </dl>

          <div class="hp" aria-hidden="true"><label for="o-website">{ui[lang].form.website}</label><input id="o-website" name="website" tabindex="-1" autocomplete="off" /></div>
          <input type="hidden" name="_ts" value="" />
          <input type="hidden" name="cart" value="" />

          <label class="check">
            <input type="checkbox" name="terms" value="yes" required />
            <span>{t.agree} <a href={L('/shop/#shipping')}>{t.terms}</a>{t.terms2 === '.' ? '.' : ` ${t.terms2}`}</span>
          </label>

          <Turnstile />
          <button class="btn btn-primary" type="submit">{online ? t.pay : t.place}</button>
          {online && <p class="muted fine">{t.secure}</p>}
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      </aside>

      <div class="card done" id="order-done" hidden>
        <h2>{t.thanks}</h2>
        <p class="lead" id="order-done-msg"></p>
        <a class="btn" href={L('/shop/')}>{t.back}</a>
      </div>
    </div>
  </section>
  </div>)}
</BaseLayout>

<script>
  import { getCart, setQty, clearCart, onCartChange } from '../scripts/cart';
  import { pageLang, pageLocale, tc } from '../i18n/client';
  import { zoneIdFor } from '../data/countries';
  const tx = tc();

  const catalogueEl = document.getElementById('catalogue');
  if (catalogueEl) initCart(catalogueEl);

  function initCart(catalogueEl: HTMLElement) {

  type Item = { id: string; name: string; price: number; image: string; stock: number; sizeStock?: Record<string, number>; preorder?: boolean; shippingClass: 'small' | 'standard' };
  // How many of this item (and size) can be ordered.
  const inStock = (item: Item, size?: string) => (item.sizeStock && size ? item.sizeStock[size] ?? 0 : item.stock);
  type Zone = { id: string; price: number; inEU: boolean };
  const { catalogue, zones, vat, max } = JSON.parse(catalogueEl.textContent!) as {
    catalogue: Item[]; zones: Zone[]; vat: { mode: 'included' | 'exempt'; rate: number }; max: number;
  };
  // Same rules as src/data/vat.ts (the server recalculates everything at checkout).
  const exVat = (gross: number) => Math.round((gross * 100) / (100 + vat.rate));
  const forZone = (gross: number, z: Zone) => (vat.mode === 'included' && !z.inEU ? exVat(gross) : gross);
  // Discount code (products only): same rounding as functions/_lib/discounts.ts.
  let code = { name: '', percent: 0 };
  const off = (cents: number) => Math.round((cents * (100 - code.percent)) / 100);

  const eur = (c: number) => new Intl.NumberFormat(pageLang() === 'en' ? 'en-IE' : pageLocale(), { style: 'currency', currency: 'EUR' }).format(c / 100);
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const list = $<HTMLUListElement>('cart-lines');
  const form = $<HTMLFormElement>('checkout-form');
  const countrySel = $<HTMLSelectElement>('o-country');
  const status = form.querySelector<HTMLElement>('.form-status')!;
  (form.elements.namedItem('_ts') as HTMLInputElement).value = String(Date.now());

  const el = (tag: string, cls?: string, text?: string) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  };

  function lines() {
    return getCart()
      .map((l) => ({ ...l, item: catalogue.find((p) => p.id === l.id) }))
      .filter((l): l is typeof l & { item: Item } => !!l.item && inStock(l.item, l.size) > 0);
  }

  function render() {
    const ls = lines();
    list.replaceChildren();
    $('cart-empty').hidden = ls.length > 0;
    $('checkout-box').hidden = ls.length === 0;

    for (const l of ls) {
      const li = el('li', 'line');
      const img = el('img') as HTMLImageElement;
      img.src = l.item.image; img.alt = ''; img.width = 96; img.height = 96;
      const info = el('div', 'line-info');
      info.append(el('strong', '', l.item.name));
      if (l.size) info.append(el('span', 'mono muted', `${tx.size}: ${l.size}`));
      if (l.item.preorder) info.append(el('span', 'tag tag-accent', tx.preorder));
      info.append(el('span', 'muted', eur(l.item.price)));

      const qty = el('div', 'qty');
      const label = `${l.item.name}${l.size ? ` (${l.size})` : ''}`;
      const cap = Math.min(max, inStock(l.item, l.size));
      const minus = el('button', 'qbtn', '−') as HTMLButtonElement;
      minus.type = 'button'; minus.setAttribute('aria-label', tx.decrease(label));
      minus.onclick = () => setQty(l.id, l.size, l.qty - 1, cap);
      const n = el('span', 'qn', String(l.qty));
      n.setAttribute('aria-label', tx.quantity(l.qty));
      const plus = el('button', 'qbtn', '+') as HTMLButtonElement;
      plus.type = 'button'; plus.setAttribute('aria-label', tx.increase(label));
      plus.disabled = l.qty >= cap;
      plus.onclick = () => setQty(l.id, l.size, l.qty + 1, cap);
      const rm = el('button', 'rm', tx.remove) as HTMLButtonElement;
      rm.type = 'button'; rm.setAttribute('aria-label', tx.removeItem(label));
      rm.onclick = () => setQty(l.id, l.size, 0);
      qty.append(minus, n, plus, rm);

      li.append(img, info, qty, el('span', 'line-total', eur(l.item.price * l.qty)));
      list.append(li);
    }
    totals(ls);
  }

  function totals(ls = lines()) {
    // Until a country is chosen, prices are shown as for the EU and shipping waits for the country.
    const chosen = countrySel.value ? zones.find((z) => z.id === zoneIdFor(countrySel.value)) : undefined;
    const zone = chosen ?? zones.find((z) => z.inEU) ?? zones[0];
    if (!zone) return;
    const full = ls.reduce((s, l) => s + forZone(l.item.price, zone) * l.qty, 0);
    const sub = ls.reduce((s, l) => s + off(forZone(l.item.price, zone)) * l.qty, 0);
    $('t-disc-row').hidden = !code.percent;
    $('t-disc-label').textContent = tx.discount(code.name, code.percent);
    $('t-disc').textContent = `−${eur(full - sub)}`;
    const ship = ls.length ? forZone(zone.price, zone) : 0;
    const total = sub + (chosen ? ship : 0);
    $('t-sub').textContent = eur(sub);
    $('t-ship').textContent = chosen ? eur(ship) : countrySel.dataset.pickCountry ?? '';
    $('t-total').textContent = eur(total);
    const included = vat.mode === 'included' && zone.inEU;
    $('t-vat-note').textContent =
      vat.mode === 'exempt' ? tx.noVat
      : zone.inEU ? tx.inclVat(vat.rate) : tx.exportVat;
    $('t-vat').textContent = included ? eur(total - exVat(total)) : '';
  }

  if (new URLSearchParams(location.search).get('payment') === 'cancelled') $('pay-cancelled').hidden = false;

  countrySel.addEventListener('change', () => totals());

  const codeInput = $<HTMLInputElement>('o-code');
  const codeMsg = $('o-code-msg');
  const applyBtn = $<HTMLButtonElement>('o-code-apply');
  async function applyCode() {
    const value = codeInput.value.trim();
    code = { name: '', percent: 0 };
    codeMsg.dataset.state = '';
    codeMsg.textContent = '';
    totals();
    if (!value) return;
    applyBtn.disabled = true;
    try {
      const res = await fetch('/api/discount', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ code: value }) });
      const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string; code?: string; percent?: number };
      if (!data.ok) throw new Error(data.error || tx.codeBad);
      code = { name: data.code!, percent: data.percent! };
      codeInput.value = data.code!;
      codeMsg.dataset.state = 'ok';
      codeMsg.textContent = tx.codeOk(data.percent!);
      totals();
    } catch (err) {
      codeMsg.dataset.state = 'error';
      codeMsg.textContent = (err as Error).message;
    } finally {
      applyBtn.disabled = false;
    }
  }
  applyBtn.addEventListener('click', applyCode);
  codeInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); applyCode(); } });
  // Changing the code removes the discount until it is applied again.
  codeInput.addEventListener('input', () => { if (code.percent) { code = { name: '', percent: 0 }; codeMsg.textContent = ''; totals(); } });
  onCartChange(render);
  render();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const cart = lines().map(({ id, size, qty }) => ({ id, size, qty }));
    (form.elements.namedItem('cart') as HTMLInputElement).value = JSON.stringify(cart);
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    btn.disabled = true;
    status.dataset.state = '';
    status.textContent = form.querySelector('input[name="method"]') ? tx.opening : tx.placing;
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string; redirectUrl?: string; message?: string };
      if (!res.ok || !data.ok) throw new Error(data.error || tx.checkoutFailed);
      if (data.redirectUrl) {
        // Hosted payment page (Stripe / NOWPayments). The cart is cleared on /order/ after paying.
        location.href = data.redirectUrl;
        return;
      }
      clearCart();
      $('checkout-box').hidden = true;
      $('order-done').hidden = false;
      $('order-done-msg').textContent = data.message ?? tx.received;
    } catch (err) {
      status.dataset.state = 'error';
      status.textContent = `${(err as Error).message} ${tx.questions(['info', 'maasflowrecords.com'].join('@'))}`;
    } finally {
      btn.disabled = false;
      (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
    }
  });
  }
</script>

<style>
  .checkout { display: grid; gap: 2rem; align-items: start; }
  .lines { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .lines :global(.line) {
    display: grid; grid-template-columns: 72px 1fr auto; gap: 0.5rem 1rem; align-items: center;
    padding: 1rem 0; border-bottom: 1px solid var(--line);
  }
  .lines :global(img) { width: 72px; height: 72px; object-fit: cover; background: var(--surface); grid-row: span 2; }
  .lines :global(.line-info) { display: grid; gap: 0.2rem; font-size: 0.92rem; justify-items: start; }
  .lines :global(.line-total) { font-weight: 600; grid-column: 3; grid-row: 1; }
  .lines :global(.qty) { grid-column: 2 / -1; display: flex; align-items: center; gap: 0.25rem; }
  .lines :global(.qbtn) { width: 40px; height: 40px; background: var(--surface); color: var(--text); border: 1px solid var(--line); font-size: 1.1rem; cursor: pointer; }
  .lines :global(.qbtn:disabled) { opacity: 0.4; cursor: not-allowed; }
  .lines :global(.qn) { min-width: 2.2rem; text-align: center; }
  .lines :global(.rm) { margin-left: auto; background: none; border: 0; color: var(--muted); text-decoration: underline; cursor: pointer; font-size: 0.82rem; min-height: 40px; }
  .code-row { display: flex; gap: 0.5rem; }
  .code-row input { flex: 1; min-width: 0; text-transform: uppercase; }
  .code-msg { margin: 0.3rem 0 0; font-size: 0.82rem; min-height: 1.1em; }
  .code-msg[data-state='ok'] { color: var(--ok); }
  .code-msg[data-state='error'] { color: var(--accent); }
  .totals .disc dd { color: var(--ok); }
  .totals div[hidden] { display: none; }
  .summary, .done { padding: clamp(1.1rem, 4vw, 1.75rem); }
  .h3 { font-size: clamp(1.35rem, 3vw, 1.75rem); }
  .totals { margin: 0; display: grid; gap: 0.5rem; padding: 1rem 0; border-block: 1px solid var(--line); }
  .totals div { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.92rem; }
  .totals dd { margin: 0; text-align: right; }
  .totals .grand { font-weight: 700; font-size: 1.05rem; }
  .totals .vat { font-size: 0.8rem; color: var(--muted); margin-top: -0.25rem; }
  .fs { border: 0; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .pay { gap: 0.6rem; }
  .opt { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.85rem 1rem; border: 1px solid var(--line); cursor: pointer; }
  .opt:has(input:checked) { border-color: var(--text); background: var(--surface-2); }
  .opt input { margin-top: 0.2rem; accent-color: var(--accent); width: 18px; height: 18px; flex: none; }
  .opt span { display: grid; gap: 0.15rem; }
  .opt small { font-size: 0.8rem; }
  .fine { font-size: 0.8rem; margin: 0; }
  .notice { border-left: 3px solid var(--accent); padding: 0.6rem 0.8rem; background: var(--surface-2); font-size: 0.9rem; }
  .fs legend { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.75rem; }
  @media (min-width: 960px) {
    .checkout { grid-template-columns: 1.5fr 1fr; gap: 3rem; }
    .summary { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  }
</style>
