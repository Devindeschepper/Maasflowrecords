---
import { photoSrcset } from '../data/img';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReleaseCard from '../components/ReleaseCard.astro';
import EventCard from '../components/EventCard.astro';
import Countdown from '../components/Countdown.astro';
import { shopOpen } from '../data/site';
import { artists } from '../data/artists';
import { beats } from '../data/services';
import { labelReleases, latestRelease, upcomingReleases } from '../data/releases';
import { upcomingEvents } from '../data/events';
import { products } from '../data/products';
import { artistNames, catalogNo, outLabel, releaseDateLabel } from '../lib/format';
import { getLang, localize, pick } from '../i18n';

const vin = artists[0];
const latest = latestRelease();
const next = upcomingReleases()[0];
const featuredRelease = next ?? latest;
const moreReleases = labelReleases().filter((r) => r.slug !== featuredRelease?.slug).slice(0, 4);
// The featured release already has its own block above, so its "Release" event isn't listed again here.
const events = upcomingEvents()
  .filter((e) => !(featuredRelease && e.kind === 'Release' && e.ticketUrl === `/music/${featuredRelease.slug}/`))
  .slice(0, 3);

const lang = getLang(Astro);
const L = (href: string) => localize(href, lang);
const t = pick(lang, {
  en: {
    eyebrow: 'Independent music label', lead1: 'Independent music label founded by producer and rapper', about: 'About the label',
    listen: '▶ Listen', discoverVin: 'Discover VIN', viewReleases: 'View releases', mainArtist: 'Main artist',
    ticker: 'MAAS FLOW RECORDS ✦ INDEPENDENT ✦ BEHIND THE BEATS ✦ BEHIND THE MIC ✦ STUDENT OF THE GAME ✦ ',
    cover: 'cover art', next: 'Next release', latest: 'Latest release', details: 'Release details', listenNow: '▶ Listen now',
    preorder: 'Pre-order the CD', latestOut: 'Latest out now:', music: 'Music', allReleases: 'All releases',
    upcoming: 'Upcoming', allEvents: 'All events', noEvents: 'No events yet. Check back soon.',
    quote: '“I rap what I live.”', readBio: 'Read the bio',
    forArtists: 'For artists', buyBeats: 'Buy beats', beatsText: 'Leases & exclusives from VIN on BeatStars.', browseBeats: 'Browse beats',
    workWithUs: 'Work with us', sendMusic: 'Send music / collab', sendText: 'Singers, rappers, producers, musicians - send your work.', join: 'Join',
    aboutLead: 'Maas Flow Records is an independent music label, created by artist and producer VIN.',
    about1: 'Everything happens in-house: the beat, the recording, the mix, the master and the release. No big label in between.',
    about2: "Right now that's VIN's music. Next up: other artists who want to grow at their own pace and stay who they are.",
    about3: 'Singer, rapper, producer or engineer? If you take your music seriously, send it to us.',
    roster: 'The roster',
  },
  fr: {
    eyebrow: 'Label de musique indépendant', lead1: 'Label de musique indépendant fondé par le producteur et rappeur', about: 'À propos du label',
    listen: '▶ Écouter', discoverVin: 'Découvrir VIN', viewReleases: 'Voir les sorties', mainArtist: 'Artiste principal',
    ticker: 'MAAS FLOW RECORDS ✦ INDÉPENDANT ✦ DERRIÈRE LES BEATS ✦ DERRIÈRE LE MICRO ✦ TOUJOURS EN TRAIN D’APPRENDRE ✦ ',
    cover: 'pochette', next: 'Prochaine sortie', latest: 'Dernière sortie', details: 'Détails de la sortie', listenNow: '▶ Écouter maintenant',
    preorder: 'Précommander le CD', latestOut: 'Dernière sortie disponible :', music: 'Musique', allReleases: 'Toutes les sorties',
    upcoming: 'À venir', allEvents: 'Tous les événements', noEvents: "Pas encore d'événements. Repasse bientôt.",
    quote: '“Je rappe ce que je vis.”', readBio: 'Lire la bio',
    forArtists: 'Pour les artistes', buyBeats: 'Acheter des beats', beatsText: 'Leases et exclusives de VIN sur BeatStars.', browseBeats: 'Voir les beats',
    workWithUs: 'Travailler avec nous', sendMusic: 'Envoyer ta musique / collab', sendText: 'Chanteurs, rappeurs, producteurs, musiciens - envoie ton travail.', join: 'Nous rejoindre',
    aboutLead: "Maas Flow Records est un label de musique indépendant, créé par l'artiste et producteur VIN.",
    about1: 'Tout se fait en interne : le beat, l’enregistrement, le mix, le master et la sortie. Pas de grand label entre les deux.',
    about2: "Pour l'instant, c'est la musique de VIN. Ensuite : d'autres artistes qui veulent grandir à leur rythme et rester eux-mêmes.",
    about3: 'Chanteur, rappeur, producteur ou ingé son ? Si tu prends ta musique au sérieux, envoie-la-nous.',
    roster: 'Les artistes',
  },
  de: {
    eyebrow: 'Unabhängiges Musiklabel', lead1: 'Unabhängiges Musiklabel, gegründet vom Producer und Rapper', about: 'Über das Label',
    listen: '▶ Anhören', discoverVin: 'VIN entdecken', viewReleases: 'Alle Releases', mainArtist: 'Hauptartist',
    ticker: 'MAAS FLOW RECORDS ✦ UNABHÄNGIG ✦ HINTER DEN BEATS ✦ HINTER DEM MIC ✦ STUDENT OF THE GAME ✦ ',
    cover: 'Cover', next: 'Nächstes Release', latest: 'Neuestes Release', details: 'Zum Release', listenNow: '▶ Jetzt anhören',
    preorder: 'CD vorbestellen', latestOut: 'Neu draußen:', music: 'Musik', allReleases: 'Alle Releases',
    upcoming: 'Demnächst', allEvents: 'Alle Events', noEvents: 'Noch keine Events. Schau bald wieder vorbei.',
    quote: '“Ich rappe, was ich lebe.”', readBio: 'Zur Bio',
    forArtists: 'Für Artists', buyBeats: 'Beats kaufen', beatsText: 'Leases & Exclusives von VIN auf BeatStars.', browseBeats: 'Beats ansehen',
    workWithUs: 'Mit uns arbeiten', sendMusic: 'Musik schicken / Collab', sendText: 'Sänger, Rapper, Producer, Musiker - schick uns deine Arbeit.', join: 'Mitmachen',
    aboutLead: 'Maas Flow Records ist ein unabhängiges Musiklabel, gegründet vom Artist und Producer VIN.',
    about1: 'Alles passiert in-house: der Beat, die Aufnahme, der Mix, das Master und das Release. Kein großes Label dazwischen.',
    about2: 'Im Moment ist das die Musik von VIN. Als Nächstes: andere Artists, die in ihrem eigenen Tempo wachsen und sie selbst bleiben wollen.',
    about3: 'Sänger, Rapper, Producer oder Engineer? Wenn du deine Musik ernst nimmst, schick sie uns.',
    roster: 'Die Artists',
  },
});
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="dot"></span>{t.eyebrow}</p>
        <h1>Maas <br />Flow <br /><span class="outline">Records</span></h1>
        <p class="lead">
          {t.lead1} <strong>VIN</strong>.
        </p>
        <p><a class="link-arrow" href="#label">{t.about}</a></p>
        <div class="btn-row">
          {latest && <a class="btn btn-primary" href={L(`/music/${latest.slug}/`)}>{t.listen}</a>}
          <a class="btn" href={L('/artists/vin/')}>{t.discoverVin}</a>
          <a class="btn btn-ghost" href={L('/music/')}>{t.viewReleases}</a>
        </div>
      </div>
      <figure class="hero-artist">
        <img src={vin.image} srcset={photoSrcset(vin.image)} sizes="(max-width: 800px) 100vw, 600px" alt={vin.imageAlt} width="720" height="900" fetchpriority="high" />
        <figcaption>
          <span class="mono muted">{t.mainArtist}</span>
          <span class="name">{vin.name}</span>
          <span class="mono muted">{vin.roles.join(' / ')}</span>
        </figcaption>
      </figure>
    </div>
    <div class="ticker" aria-hidden="true">
      <div class="ticker-track mono">
        {Array.from({ length: 2 }).map(() => (
          <span>{t.ticker}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- LATEST / NEXT RELEASE -->
  {
    featuredRelease && (
      <section class="section">
        <div class="container feature">
          <a href={L(`/music/${featuredRelease.slug}/`)} class="feature-cover">
            <img src={featuredRelease.cover} alt={`${featuredRelease.title} ${t.cover}`} width="700" height="700" loading="lazy" />
          </a>
          <div>
            <p class="eyebrow">
              <span class="dot" />
              {next ? t.next : t.latest} · {catalogNo(featuredRelease)}
            </p>
            <h2>{featuredRelease.title}</h2>
            <p class="mono muted">
              {featuredRelease.type} · {artistNames(featuredRelease)} · {next ? outLabel(featuredRelease, lang) : releaseDateLabel(featuredRelease, lang)}
            </p>
            {next && featuredRelease.releaseDate && <Countdown date={featuredRelease.releaseDate} tentative={featuredRelease.dateTentative} />}
            <p class="lead">{featuredRelease.description}</p>
            <div class="btn-row">
              <a class="btn btn-primary" href={L(`/music/${featuredRelease.slug}/`)}>
                {next ? t.details : t.listenNow}
              </a>
              {shopOpen && next && products.some((p) => p.preorder) && <a class="btn" href={L('/shop/')}>{t.preorder}</a>}
            </div>
            {latest && next && (
              <p class="also muted">
                {t.latestOut} <a href={L(`/music/${latest.slug}/`)}>{latest.title}</a>
              </p>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- MUSIC -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{t.music}</h2>
        <a class="link-arrow" href={L('/music/')}>{t.allReleases}</a>
      </div>
      <div class="grid grid-4">
        {moreReleases.map((r) => <ReleaseCard release={r} />)}
      </div>
    </div>
  </section>

  <!-- EVENTS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{t.upcoming}</h2>
        <a class="link-arrow" href={L('/events/')}>{t.allEvents}</a>
      </div>
      {events.length ? events.map((e) => <EventCard event={e} compact />) : <p class="empty">{t.noEvents}</p>}
    </div>
  </section>

  <!-- ARTIST SPOTLIGHT -->
  <section class="section spotlight">
    <div class="container spotlight-grid">
      <div>
        <h2>{vin.name}</h2>
        <blockquote>{t.quote}</blockquote>
        <p class="lead muted">{vin.description}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={L('/artists/vin/')}>{t.discoverVin}</a>
          <a class="btn btn-ghost" href={L('/bio/#vin')}>{t.readBio}</a>
        </div>
      </div>
      <div class="split-cards">
        <a class="split card" href={beats.beatstars || L('/services/')} {...(beats.beatstars ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
          <p class="mono muted">{t.forArtists}</p>
          <h3>{t.buyBeats}</h3>
          <p class="muted">{t.beatsText}</p>
          <span class="link-arrow">{t.browseBeats}</span>
        </a>
        <a class="split card" href={L('/casting/')}>
          <p class="mono muted">{t.workWithUs}</p>
          <h3>{t.sendMusic}</h3>
          <p class="muted">{t.sendText}</p>
          <span class="link-arrow">{t.join}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ABOUT THE LABEL -->
  <section class="section about" id="label">
    <div class="container about-grid">
      <div>
        <h2>Maas Flow Records</h2>
      </div>
      <div class="prose">
        <p class="lead">{t.aboutLead}</p>
        <p class="muted">{t.about1}</p>
        <p class="muted">{t.about2}</p>
        <p class="muted">{t.about3}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={L('/artists/')}>{t.roster}</a>
          <a class="btn btn-ghost" href={L('/casting/')}>{t.workWithUs}</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero { position: relative; border-bottom: 1px solid var(--line); overflow: hidden; }
  .hero-grid { display: grid; gap: 2.5rem; padding-top: clamp(2.5rem, 8vw, 5rem); padding-bottom: 3.5rem; }
  .hero h1 { font-size: clamp(4rem, 17vw, 10rem); line-height: 0.86; margin-bottom: 1.5rem; }
  .outline { color: transparent; -webkit-text-stroke: 1.5px var(--text); }
  .hero .lead { margin-bottom: 1.75rem; }
  .hero-artist { margin: 0; position: relative; border: 1px solid var(--line); background: var(--surface); }
  .hero-artist img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .hero-artist figcaption {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 1rem;
    display: grid; gap: 0.2rem; background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
  }
  .hero-artist .name { font-family: var(--font-display); font-size: 3rem; line-height: 1; }
  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: 1.35fr 1fr; align-items: end; }
  }

  .ticker { border-top: 1px solid var(--line); overflow: hidden; white-space: nowrap; padding: 0.7rem 0; }
  .ticker-track { display: inline-block; animation: tick 40s linear infinite; font-size: 0.72rem; letter-spacing: 0.2em; color: var(--muted); }
  @keyframes tick { to { transform: translateX(-50%); } }

  .feature { display: grid; gap: 2rem; align-items: center; }
  .feature-cover { display: block; border: 1px solid var(--line); }
  .feature-cover img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .feature h2 { font-size: clamp(2.6rem, 8vw, 5rem); }
  .feature .mono { margin-bottom: 1.25rem; }
  .also { margin-top: 1.25rem; font-size: 0.9rem; }
  @media (min-width: 860px) { .feature { grid-template-columns: 1fr 1.1fr; gap: 4rem; } }

  .spotlight-grid { display: grid; gap: 2.5rem; }
  .spotlight h2 { font-size: clamp(4rem, 14vw, 8rem); }
  blockquote { margin: 0 0 1rem; font-family: var(--font-display); font-size: clamp(1.5rem, 4vw, 2.2rem); text-transform: uppercase; color: var(--accent); }
  .split-cards { display: grid; gap: 1rem; align-content: end; }
  .split { display: block; padding: 1.5rem; text-decoration: none; transition: border-color 0.15s; }
  .split:hover { border-color: var(--text); }
  .split .mono { margin-bottom: 0.5rem; font-size: 0.68rem; }
  @media (min-width: 900px) { .spotlight-grid { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }

  .about-grid { display: grid; gap: 1.5rem; }
  .about h2 { font-size: clamp(2.6rem, 8vw, 5rem); }
  .about .prose p { margin: 0 0 1rem; max-width: 62ch; }
  .about .prose strong { color: var(--text); }
  .about .prose .lead { font-size: clamp(1.2rem, 2.6vw, 1.45rem); color: var(--text); }
  @media (min-width: 900px) { .about-grid { grid-template-columns: 1fr 1.3fr; gap: 4rem; } }
</style>
