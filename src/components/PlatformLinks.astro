---
// Renders a list of platform links from a `Links` map.
// Empty URLs render as a greyed-out "soon" entry so placeholders stay visible.
import type { Links, PlatformId } from '../data/types';
import { platforms, platformOrder } from '../data/platforms';
import PlatformIcon from './PlatformIcon.astro';

interface Props {
  links: Links;
  /** "chips" = labelled buttons, "icons" = compact icon row, "list" = big rows */
  variant?: 'chips' | 'icons' | 'list';
  /** Hide platforms whose URL is still empty. */
  hideEmpty?: boolean;
  context?: string;
}
const { links, variant = 'chips', hideEmpty = false, context = '' } = Astro.props;

const entries = platformOrder
  .filter((id) => id in links)
  .map((id) => ({ id: id as PlatformId, url: links[id] ?? '', label: platforms[id].label }))
  .filter((e) => !hideEmpty || e.url);
---

{
  entries.length > 0 && (
    <ul class:list={['platforms', `platforms--${variant}`]}>
      {entries.map((e) => (
        <li>
          {e.url ? (
            <a href={e.url} target="_blank" rel="noopener noreferrer" aria-label={variant === 'icons' ? `${context} ${e.label}`.trim() : undefined}>
              <PlatformIcon id={e.id} size={variant === 'list' ? 26 : 18} />
              {variant !== 'icons' && <span class="label">{e.label}</span>}
              {variant === 'list' && <span class="go" aria-hidden="true">↗</span>}
            </a>
          ) : (
            <span class="soon" title={`${e.label} - link coming soon`}>
              <PlatformIcon id={e.id} size={variant === 'list' ? 26 : 18} />
              {variant !== 'icons' ? <span class="label">{e.label}</span> : <span class="sr-only">{e.label} (coming soon)</span>}
              {variant !== 'icons' && <span class="soon-tag">soon</span>}
            </span>
          )}
        </li>
      ))}
    </ul>
  )
}

<style>
  .platforms { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .platforms a, .soon { display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none; }
  .soon { opacity: 0.4; cursor: default; }
  .soon-tag { font: 0.62rem var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }

  .platforms--chips a, .platforms--chips .soon {
    min-height: 40px; padding: 0.45rem 0.8rem; border: 1px solid var(--line);
    font-size: 0.8rem; font-weight: 500;
  }
  .platforms--chips a:hover { border-color: var(--text); }

  .platforms--icons { gap: 0.25rem; }
  .platforms--icons a, .platforms--icons .soon { width: 44px; height: 44px; justify-content: center; color: var(--muted); }
  .platforms--icons a:hover { color: var(--text); }

  .platforms--list { flex-direction: column; gap: 0; border-top: 1px solid var(--line); }
  .platforms--list li { border-bottom: 1px solid var(--line); }
  .platforms--list a, .platforms--list .soon {
    display: flex; width: 100%; padding: 1.1rem 0.25rem; gap: 1rem;
    font-family: var(--font-display); font-size: clamp(1.4rem, 4vw, 2rem); text-transform: uppercase;
  }
  .platforms--list .label { flex: 1; }
  .platforms--list .go { font-family: var(--font-body); font-size: 1.25rem; transition: transform 0.15s; }
  .platforms--list a:hover { color: var(--accent); }
  .platforms--list a:hover .go { transform: translate(3px, -3px); }
</style>
