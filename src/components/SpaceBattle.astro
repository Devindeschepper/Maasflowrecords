---
/**
 * Space battle far away in the background (admin panel → Settings → "Space battle"): two fleets (red and teal)
 * of fighters dogfight in 3D, each side has a big battleship far behind firing laser bursts, and ships blow up
 * with flashes and shockwaves, then new fighters fly in from the distance.
 * One canvas behind the content, ~30 frames a second, paused while the tab is hidden, and off for people who ask
 * their device for less motion. Generic ship shapes (no film designs).
 */
---

<canvas class="battle" aria-hidden="true" data-battle></canvas>

<style>
  .battle { position: fixed; inset: 0; z-index: -1; width: 100%; height: 100%; pointer-events: none; opacity: 0.85; }
  @media (prefers-reduced-motion: reduce) { .battle { display: none; } }
</style>

<script>
  type V = { x: number; y: number; z: number };
  type Ship = { team: 0 | 1; capital: boolean; p: V; v: V; hp: number; cool: number; burst: number; dead: number; target: Ship | null };
  type Laser = { team: 0 | 1; p: V; v: V; life: number };
  type Spark = { p: V; v: V; life: number; max: number; big: boolean };
  type Ring = { p: V; life: number; max: number };

  const canvas = document.querySelector<HTMLCanvasElement>('[data-battle]');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const COLORS = [
      { hull: '#d9d4cf', glow: '228, 67, 45', laser: '255, 80, 60' }, // red fleet (label colour)
      { hull: '#b9c6cc', glow: '60, 200, 230', laser: '90, 230, 255' }, // teal fleet
    ];
    const PER_TEAM = 6;
    const SPEED = 0.32; // world units per second
    const LASER_SPEED = 1.6;
    const add = (a: V, b: V, k = 1): V => ({ x: a.x + b.x * k, y: a.y + b.y * k, z: a.z + b.z * k });
    const sub = (a: V, b: V): V => ({ x: a.x - b.x, y: a.y - b.y, z: a.z - b.z });
    const len = (a: V) => Math.hypot(a.x, a.y, a.z) || 1e-6;
    const norm = (a: V, k = 1): V => { const l = len(a); return { x: (a.x / l) * k, y: (a.y / l) * k, z: (a.z / l) * k }; };
    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    // World: x -1..1, y -0.7..0.7, depth z 2..5 (bigger = farther away).
    const spawn = (team: 0 | 1, far = false): Ship => ({
      team, capital: false,
      p: { x: (team ? 1 : -1) * rand(0.7, 1.2), y: rand(-0.7, 0.7), z: far ? 5.5 : rand(2.4, 4.6) },
      v: norm({ x: team ? -1 : 1, y: rand(-0.3, 0.3), z: rand(-0.3, 0.3) }, SPEED),
      hp: 3, cool: rand(0.3, 1.5), burst: 0, dead: 0, target: null,
    });
    // Battleships: far behind their fleet, drifting slowly, can't be destroyed.
    const capital = (team: 0 | 1): Ship => ({
      team, capital: true,
      p: { x: team ? 2 : -2, y: team ? 0.9 : -0.8, z: 6.5 },
      v: { x: team ? -0.02 : 0.02, y: 0, z: 0 },
      hp: Infinity, cool: rand(1, 2), burst: 0, dead: 0, target: null,
    });
    const ships: Ship[] = [
      capital(0), capital(1),
      ...Array.from({ length: PER_TEAM }, () => spawn(0)), ...Array.from({ length: PER_TEAM }, () => spawn(1)),
    ];
    const lasers: Laser[] = [];
    const sparks: Spark[] = [];
    const rings: Ring[] = [];

    let W = 0, H = 0, dpr = 1;
    const resize = () => {
      dpr = Math.min(1.5, devicePixelRatio || 1);
      W = innerWidth; H = innerHeight;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    addEventListener('resize', resize);

    // Perspective: things farther away are smaller and closer to the middle.
    // The battle fills the whole screen on phones and computers; ships are a bit smaller on small screens.
    const project = (p: V) => ({ x: W / 2 + (p.x / p.z) * W * 1.1, y: H * 0.45 + (p.y / p.z) * H * 1.1, s: (1 / p.z) * Math.min(1, Math.max(0.6, W / 1000)) });

    const explode = (p: V, big: boolean) => {
      if (big) rings.push({ p: { ...p }, life: 0.9, max: 0.9 });
      const n = big ? 34 : 7;
      for (let i = 0; i < n; i++) {
        const max = big ? rand(0.6, 1.2) : rand(0.2, 0.4);
        sparks.push({ p: { ...p }, v: norm({ x: rand(-1, 1), y: rand(-1, 1), z: rand(-1, 1) }, rand(0.05, big ? 0.35 : 0.15)), life: max, max, big });
      }
    };

    const step = (dt: number) => {
      for (const s of ships) {
        if (s.capital) {
          // Drift slowly back and forth; fire bursts at a random enemy fighter.
          const out = s.p.x * s.v.x > 0;
          if ((out && Math.abs(s.p.x) > 2.3) || (!out && Math.abs(s.p.x) < 1.5)) s.v.x = -s.v.x;
          s.p = add(s.p, s.v, dt);
          s.cool -= dt;
          if (s.cool <= 0) {
            const enemies = ships.filter((o) => o.team !== s.team && !o.capital && o.dead <= 0);
            const t = enemies[Math.floor(Math.random() * enemies.length)];
            if (t) {
              const from = add(s.p, { x: rand(-0.25, 0.25), y: rand(-0.03, 0.03), z: 0 });
              lasers.push({ team: s.team, p: from, v: norm(add(sub(t.p, from), { x: rand(-0.3, 0.3), y: rand(-0.3, 0.3), z: rand(-0.3, 0.3) }), LASER_SPEED * 1.3), life: 3 });
            }
            s.cool = ++s.burst % 4 ? 0.12 : rand(0.8, 2);
          }
          continue;
        }
        if (s.dead > 0) {
          s.dead -= dt;
          if (s.dead <= 0) Object.assign(s, spawn(s.team, true)); // a new ship flies in from far away
          continue;
        }
        if (!s.target || s.target.dead > 0 || Math.random() < dt * 0.1) {
          const enemies = ships.filter((o) => o.team !== s.team && !o.capital && o.dead <= 0);
          s.target = enemies[Math.floor(Math.random() * enemies.length)] ?? null;
        }
        // Steer: chase the target (aim a bit behind it), weave a little, stay inside the battle area.
        let want: V = s.target ? sub(add(s.target.p, s.target.v, -0.6), s.p) : { x: -s.p.x, y: -s.p.y, z: 3.5 - s.p.z };
        if (s.target && len(sub(s.target.p, s.p)) < 0.25) want = add(want, { x: rand(-1, 1), y: rand(-1, 1), z: rand(-1, 1) }, 0.5); // break off
        const home: V = { x: Math.abs(s.p.x) > 1.3 ? -s.p.x : 0, y: Math.abs(s.p.y) > 0.8 ? -s.p.y : 0, z: s.p.z < 2.2 ? 1 : s.p.z > 5 ? -1 : 0 };
        want = add(norm(want), home, 2);
        s.v = norm(add(s.v, norm(want, SPEED), dt * 1.6), SPEED);
        s.p = add(s.p, s.v, dt);
        // Fire when the target is roughly in front.
        s.cool -= dt;
        if (s.target && s.cool <= 0) {
          const to = sub(s.target.p, s.p);
          const facing = (to.x * s.v.x + to.y * s.v.y + to.z * s.v.z) / (len(to) * SPEED);
          if (facing > 0.85 && len(to) < 1.4) {
            lasers.push({ team: s.team, p: add(s.p, s.v, 0.05), v: norm(add(norm(to), { x: rand(-0.08, 0.08), y: rand(-0.08, 0.08), z: rand(-0.08, 0.08) }), LASER_SPEED), life: 1.1 });
            s.cool = ++s.burst % 3 ? 0.09 : rand(0.25, 0.9); // short bursts of 3
          }
        }
      }
      for (let i = lasers.length - 1; i >= 0; i--) {
        const l = lasers[i];
        l.p = add(l.p, l.v, dt);
        l.life -= dt;
        const hit = ships.find((s) => s.team !== l.team && s.dead <= 0 && len(sub(s.p, l.p)) < (s.capital ? 0.18 : 0.07));
        if (hit) {
          explode(l.p, false);
          if (!hit.capital && --hit.hp <= 0) { explode(hit.p, true); hit.dead = rand(1.5, 3.5); }
          l.life = 0;
        }
        if (l.life <= 0) lasers.splice(i, 1);
      }
      for (let i = rings.length - 1; i >= 0; i--) {
        rings[i].life -= dt;
        if (rings[i].life <= 0) rings.splice(i, 1);
      }
      for (let i = sparks.length - 1; i >= 0; i--) {
        const k = sparks[i];
        k.p = add(k.p, k.v, dt);
        k.life -= dt;
        if (k.life <= 0) sparks.splice(i, 1);
      }
    };

    // Two generic ship shapes, drawn pointing right (+x), size about 1 unit.
    const drawShip = (team: number) => {
      ctx.beginPath();
      if (team === 0) { // arrow fighter with swept wings
        ctx.moveTo(1, 0); ctx.lineTo(-0.6, -0.55); ctx.lineTo(-0.3, 0); ctx.lineTo(-0.6, 0.55);
      } else { // twin-pod interceptor
        ctx.moveTo(0.9, 0); ctx.lineTo(0.1, -0.25); ctx.lineTo(-0.2, -0.7); ctx.lineTo(-0.6, -0.7); ctx.lineTo(-0.35, -0.2);
        ctx.lineTo(-0.6, 0); ctx.lineTo(-0.35, 0.2); ctx.lineTo(-0.6, 0.7); ctx.lineTo(-0.2, 0.7); ctx.lineTo(0.1, 0.25);
      }
      ctx.closePath();
      ctx.fill();
    };

    // Battleship: long wedge hull with a bridge tower and a row of engines, drawn pointing right.
    const drawCapital = (team: number) => {
      ctx.beginPath();
      ctx.moveTo(1, 0); ctx.lineTo(-0.7, -0.32); ctx.lineTo(-0.75, -0.1); ctx.lineTo(-0.75, 0.1); ctx.lineTo(-0.7, 0.32);
      ctx.closePath(); ctx.fill();
      ctx.fillRect(-0.55, -0.42, 0.22, 0.12); // bridge tower
      ctx.fillStyle = `rgba(${COLORS[team].glow}, 0.95)`;
      for (const y of [-0.2, 0, 0.2]) { ctx.beginPath(); ctx.arc(-0.76, y, 0.06, 0, Math.PI * 2); ctx.fill(); }
    };

    const draw = () => {
      ctx.clearRect(0, 0, W, H);
      type Item = { z: number; paint: () => void };
      const items: Item[] = [];
      for (const s of ships) {
        if (s.dead > 0) continue;
        const a = project(s.p);
        if (s.capital) {
          items.push({ z: s.p.z, paint: () => {
            const size = 520 * a.s;
            ctx.save();
            ctx.globalAlpha = 0.55; // hazy, far away
            ctx.translate(a.x, a.y);
            if (s.team) ctx.scale(-1, 1); // both face the middle
            ctx.scale(size / 2, size / 2.6);
            ctx.fillStyle = '#8f8a86';
            drawCapital(s.team);
            ctx.restore();
          } });
          continue;
        }
        const b = project(add(s.p, s.v, 0.1));
        const angle = Math.atan2(b.y - a.y, b.x - a.x);
        const size = 34 * a.s; // far away: about 7-17 px
        const fade = Math.min(1, Math.max(0.25, 1.6 - s.p.z / 4)); // farther = dimmer, like haze
        items.push({ z: s.p.z, paint: () => {
          const c = COLORS[s.team];
          ctx.save();
          ctx.globalAlpha = fade;
          // engine trail
          const tail = project(add(s.p, s.v, -0.35));
          const g = ctx.createLinearGradient(a.x, a.y, tail.x, tail.y);
          g.addColorStop(0, `rgba(${c.glow}, 0.7)`); g.addColorStop(1, `rgba(${c.glow}, 0)`);
          ctx.strokeStyle = g; ctx.lineWidth = Math.max(1, size * 0.18);
          ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(tail.x, tail.y); ctx.stroke();
          ctx.translate(a.x, a.y); ctx.rotate(angle); ctx.scale(size / 2, size / 2);
          ctx.fillStyle = c.hull; drawShip(s.team);
          ctx.fillStyle = `rgba(${c.glow}, 0.9)`; ctx.beginPath(); ctx.arc(-0.45, 0, 0.14, 0, Math.PI * 2); ctx.fill();
          ctx.restore();
        } });
      }
      for (const l of lasers) {
        items.push({ z: l.p.z, paint: () => {
          const a = project(l.p), b = project(add(l.p, l.v, -0.07));
          const c = COLORS[l.team].laser;
          ctx.save();
          ctx.globalAlpha = Math.min(1, l.life * 3);
          ctx.strokeStyle = `rgba(${c}, 0.95)`; ctx.lineCap = 'round';
          ctx.shadowColor = `rgba(${c}, 0.9)`; ctx.shadowBlur = 6;
          ctx.lineWidth = Math.max(1, 3 * a.s);
          ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          ctx.restore();
        } });
      }
      for (const k of sparks) {
        items.push({ z: k.p.z, paint: () => {
          const a = project(k.p);
          const t = k.life / k.max;
          ctx.save();
          ctx.globalAlpha = t;
          ctx.fillStyle = t > 0.6 ? '#fff6d8' : t > 0.3 ? '#ffb347' : '#e4432d';
          ctx.shadowColor = '#ff8a3d'; ctx.shadowBlur = k.big ? 10 : 4;
          ctx.beginPath(); ctx.arc(a.x, a.y, Math.max(0.8, (k.big ? 5 : 2.5) * a.s * (0.5 + t)), 0, Math.PI * 2); ctx.fill();
          ctx.restore();
        } });
      }
      for (const r of rings) {
        items.push({ z: r.p.z, paint: () => {
          const a = project(r.p);
          const t = r.life / r.max;
          ctx.save();
          // flash: a short glow that lights up the area
          const glow = ctx.createRadialGradient(a.x, a.y, 0, a.x, a.y, 120 * a.s * (1.4 - t));
          glow.addColorStop(0, `rgba(255, 200, 140, ${0.45 * t * t})`); glow.addColorStop(1, 'rgba(255, 120, 60, 0)');
          ctx.fillStyle = glow;
          ctx.fillRect(a.x - 200, a.y - 200, 400, 400);
          // shockwave ring
          ctx.globalAlpha = t * 0.8;
          ctx.strokeStyle = '#ffd2a6'; ctx.lineWidth = Math.max(1, 2.5 * a.s * 3 * t);
          ctx.beginPath(); ctx.ellipse(a.x, a.y, 70 * a.s * (1 - t) + 2, 40 * a.s * (1 - t) + 1, 0, 0, Math.PI * 2); ctx.stroke();
          ctx.restore();
        } });
      }
      items.sort((p, q) => q.z - p.z).forEach((i) => i.paint()); // far things first
    };

    let last = performance.now();
    let acc = 0;
    const frame = (now: number) => {
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      acc += dt;
      if (acc >= 1 / 30) { // ~30 fps is plenty for something this small and far away
        step(acc);
        draw();
        acc = 0;
      }
      if (!document.hidden) requestAnimationFrame(frame);
    };
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) { last = performance.now(); requestAnimationFrame(frame); }
    });
    requestAnimationFrame(frame);
  }
</script>
