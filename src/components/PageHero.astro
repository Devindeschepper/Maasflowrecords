---
interface Props { eyebrow?: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {eyebrow && <p class="eyebrow"><span class="dot"></span>{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead muted">{lead}</p>}
    <slot />
  </div>
</section>
