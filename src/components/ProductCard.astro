---
import type { Product } from '../data/types';
import { formatPrice } from '../data/products';
import { getLang, pick } from '../i18n';
import { categoryLabel } from '../i18n/shop';

interface Props {
  product: Product;
  /** Shop closed: show the product, but no ordering. */
  comingSoon?: boolean;
}
const { product: p, comingSoon = false } = Astro.props;
const soldOut = p.stock <= 0;
const low = !soldOut && p.stock <= 5;
const lang = getLang(Astro);
const t = pick(lang, {
  en: { soon: 'Coming soon', soldOut: 'Sold out', preorder: 'Pre-order', only: (n: number) => `Only ${n} left`, sizeOut: 'sold out', inStock: 'In stock', size: 'Size', chooseSize: 'Choose size', add: 'Add to cart', back: "Tell me when it's back" },
  fr: { soon: 'Bientôt', soldOut: 'Épuisé', preorder: 'Précommande', only: (n) => `Plus que ${n}`, sizeOut: 'épuisé', inStock: 'En stock', size: 'Taille', chooseSize: 'Choisir la taille', add: 'Ajouter au panier', back: 'Me prévenir du retour' },
  de: { soon: 'Demnächst', soldOut: 'Ausverkauft', preorder: 'Vorbestellen', only: (n) => `Nur noch ${n}`, sizeOut: 'ausverkauft', inStock: 'Auf Lager', size: 'Größe', chooseSize: 'Größe wählen', add: 'In den Warenkorb', back: 'Benachrichtigen, wenn wieder da' },
});
// With stock per size, a sold-out size can't be chosen.
const sizeLeft = (size: string) => p.sizeStock?.[size];
const stockLabel = comingSoon ? t.soon : soldOut ? t.soldOut : p.preorder ? t.preorder : low ? t.only(p.stock) : t.inStock;
---

<article class="product" data-product-id={p.id}>
  <div class="img">
    <img src={p.image} alt={p.name} width="600" height="600" loading="lazy" decoding="async" />
    <span class:list={['tag', 'stock', { 'tag-accent': comingSoon || low || p.preorder }]}>{stockLabel}</span>
  </div>
  <div class="info">
    <p class="mono muted cat">{categoryLabel(p.category, lang)}</p>
    <h3>{p.name}</h3>
    {!comingSoon && <p class="price">{formatPrice(p.price, lang)}</p>}
    <p class="desc muted">{p.description}</p>

    {comingSoon ? (
      <div class="add">
        <button class="btn" type="button" disabled>{t.soon}</button>
      </div>
    ) : (
      <form class="add" data-add-to-cart data-max={Math.min(10, p.stock)}>
        <input type="hidden" name="id" value={p.id} />
        {
          p.sizes && (
            <div class="field">
              <label for={`size-${p.id}`}>{t.size}</label>
              <select id={`size-${p.id}`} name="size" required disabled={soldOut}>
                <option value="">{t.chooseSize}</option>
                {p.sizes.map((s) => <option value={s} disabled={sizeLeft(s) === 0} data-max={sizeLeft(s) === undefined ? undefined : Math.min(10, sizeLeft(s)!)}>{sizeLeft(s) === 0 ? `${s} - ${t.sizeOut}` : s}</option>)}
              </select>
            </div>
          )
        }
        <button class="btn btn-primary" type="submit" disabled={soldOut}>
          {soldOut ? t.soldOut : p.preorder ? t.preorder : t.add}
        </button>
        {soldOut && <a class="btn btn-ghost" href="#restock" data-restock={p.id}>{t.back}</a>}
        <p class="added mono" role="status" aria-live="polite"></p>
      </form>
    )}
  </div>
</article>

<style>
  .product { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); }
  .img { position: relative; aspect-ratio: 1; background: var(--surface-2); overflow: hidden; }
  .img img { width: 100%; height: 100%; object-fit: cover; }
  .stock { position: absolute; top: 0.75rem; left: 0.75rem; background: var(--bg); }
  .info { display: flex; flex-direction: column; flex: 1; padding: 1.1rem; }
  .cat { margin: 0 0 0.4rem; font-size: 0.68rem; }
  h3 { margin-bottom: 0.4rem; }
  .price { font-weight: 600; margin: 0 0 0.6rem; }
  .desc { font-size: 0.88rem; }
  .add { margin-top: auto; display: grid; gap: 0.75rem; }
  .add .btn { width: 100%; }
  .add .btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .added { min-height: 1.2em; margin: 0; font-size: 0.72rem; color: var(--ok); }
</style>
