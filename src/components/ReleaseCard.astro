---
import type { Release } from '../data/types';
import { isUpcoming } from '../data/releases';
import { artistNames, catalogNo, fmtDate } from '../lib/format';
import PreviewButton from './PreviewButton.astro';

interface Props { release: Release; headingLevel?: 'h2' | 'h3' }
const { release: r, headingLevel: H = 'h3' } = Astro.props;
const upcoming = isUpcoming(r);
---

<article class="release">
  <a href={`/music/${r.slug}/`} class="cover-link">
    <div class="cover">
      <img src={r.cover} alt={`${r.title} cover art`} width="600" height="600" loading="lazy" decoding="async" />
      {upcoming && <span class="tag tag-accent badge">Upcoming</span>}
    </div>
    <div class="meta">
      <p class="mono muted">{catalogNo(r)} · {r.type}</p>
      <H class="title">{r.title}</H>
      <p class="sub">{artistNames(r)} <span class="muted">— {upcoming ? 'Out ' : ''}{fmtDate(r.releaseDate)}</span></p>
    </div>
  </a>
  {r.preview && <div class="play"><PreviewButton src={r.preview} title={r.title} /></div>}
</article>

<style>
  .release { position: relative; }
  .play { position: absolute; top: 0; right: 0; aspect-ratio: 1; width: 100%; pointer-events: none; display: flex; align-items: flex-end; justify-content: flex-end; padding: 0.75rem; }
  .play :global(button) { pointer-events: auto; }
  .cover-link { display: block; text-decoration: none; }
  .cover { position: relative; aspect-ratio: 1; overflow: hidden; background: var(--surface); border: 1px solid var(--line); }
  .cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease, filter 0.3s; filter: grayscale(0.15); }
  .cover-link:hover img { transform: scale(1.03); filter: none; }
  .badge { position: absolute; top: 0.75rem; left: 0.75rem; background: var(--bg); }
  .meta { padding-top: 0.9rem; }
  .meta .mono { margin: 0 0 0.35rem; font-size: 0.7rem; }
  .title { margin: 0 0 0.3rem; }
  .cover-link:hover .title { color: var(--accent); }
  .sub { margin: 0; font-size: 0.9rem; }
</style>
