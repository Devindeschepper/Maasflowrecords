---
// Shown on the shop and cart while test mode is on (admin panel → Settings).
import { paymentMethods } from '../data/site';
import { getLang, pick } from '../i18n';

const t = pick(getLang(Astro), {
  en: { test: 'Test shop', none: '- no real payments, nothing is charged or shipped.', card: 'Test card:', any: ', any future date, any CVC.' },
  fr: { test: 'Boutique test', none: "- pas de vrais paiements, rien n'est débité ni envoyé.", card: 'Carte test :', any: ', une date future, n’importe quel CVC.' },
  de: { test: 'Test-Shop', none: '- keine echten Zahlungen, nichts wird abgebucht oder verschickt.', card: 'Testkarte:', any: ', beliebiges zukünftiges Datum, beliebiger CVC.' },
});
---

<div class="container">
  <p class="test" role="note">
    <strong>{t.test}</strong> {t.none}
    {paymentMethods.card && <> {t.card} <span class="mono">4242 4242 4242 4242</span>{t.any}</>}
  </p>
</div>

<style>
  .test {
    margin: 1.5rem 0 0; padding: 0.8rem 1rem; border: 1px dashed var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent); font-size: 0.9rem;
  }
  .test strong { color: var(--accent); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem; margin-right: 0.25rem; }
  .mono { font-family: var(--font-mono); white-space: nowrap; }
</style>
