---
// Shown instead of the shop while `shopOpen` is false (src/data/site.ts).
import PlatformLinks from './PlatformLinks.astro';
import ProductCard from './ProductCard.astro';
import { labelSocials, site } from '../data/site';
import { products } from '../data/products';
---

<section class="section">
  <div class="container soon">
    <div>
      <p class="eyebrow"><span class="dot"></span>Coming soon</p>
      <h2>The first drop is on the way</h2>
      <p class="lead muted">
        The 2Real4U CD is in the works. Follow Maas Flow Records to be the first to
        know when the shop opens.
      </p>
      <PlatformLinks links={labelSocials} variant="chips" hideEmpty />
      <p class="muted small">Questions or wholesale? <a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <div class="coming" aria-label="What's coming">
      {products.map((p) => <ProductCard product={p} comingSoon />)}
    </div>
  </div>
</section>

<style>
  .soon { display: grid; gap: 2.5rem; align-items: center; }
  .soon h2 { max-width: 14ch; }
  .small { font-size: 0.88rem; margin-top: 1.5rem; }
  .coming { display: grid; gap: 1rem; max-width: 380px; width: 100%; }
  @media (min-width: 900px) { .soon { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
</style>
