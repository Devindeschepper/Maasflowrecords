---
// Shown instead of the shop while `shopOpen` is false (src/data/site.ts), or, with `dropAt`, as the countdown
// of a timed drop: at that second it hides itself and shows the shop ([data-drop-content]) in the browser.
import Email from './Email.astro';
import PlatformLinks from './PlatformLinks.astro';
import ProductCard from './ProductCard.astro';
import { labelSocials } from '../data/site';
import { products } from '../data/products';
import { getLang, pick } from '../i18n';

interface Props { dropAt?: string }
const { dropAt } = Astro.props;
const t = pick(getLang(Astro), {
  en: { drop: 'The drop', soon: 'Coming soon', dropping: 'Dropping in', units: ['days', 'hours', 'min', 'sec'], opens: 'The shop opens', limited: 'Limited pieces, so be quick. Follow us to get the reminder.', first: 'The first drop is coming', firstText: 'The 2Real4U CD is coming. Follow us on Instagram or TikTok to see when the shop opens.', questions: 'Questions or wholesale?', coming: "What's coming" },
  fr: { drop: 'Le drop', soon: 'Bientôt', dropping: 'Drop dans', units: ['jours', 'heures', 'min', 'sec'], opens: 'La boutique ouvre', limited: 'Pièces limitées, alors sois rapide. Suis-nous pour avoir le rappel.', first: 'Le premier drop arrive', firstText: 'Le CD 2Real4U arrive. Suis-nous sur Instagram ou TikTok pour savoir quand la boutique ouvre.', questions: 'Questions ou vente en gros ?', coming: 'Ce qui arrive' },
  de: { drop: 'Der Drop', soon: 'Demnächst', dropping: 'Drop in', units: ['Tage', 'Std', 'Min', 'Sek'], opens: 'Der Shop öffnet', limited: 'Limitierte Stückzahl, also sei schnell. Folg uns, um die Erinnerung zu bekommen.', first: 'Der erste Drop kommt', firstText: 'Die 2Real4U CD kommt. Folg uns auf Instagram oder TikTok, um zu sehen, wann der Shop öffnet.', questions: 'Fragen oder Großhandel?', coming: 'Was kommt' },
});
---

<section class="section" data-drop-gate={dropAt}>
  <div class="container soon">
    <div>
      <p class="eyebrow"><span class="dot"></span>{dropAt ? t.drop : t.soon}</p>
      {dropAt ? (
        <>
          <h2>{t.dropping}</h2>
          <p class="clock" data-drop-clock aria-live="off">
            <span><b data-u="d">-</b><small>{t.units[0]}</small></span>
            <span><b data-u="h">--</b><small>{t.units[1]}</small></span>
            <span><b data-u="m">--</b><small>{t.units[2]}</small></span>
            <span><b data-u="s">--</b><small>{t.units[3]}</small></span>
          </p>
          <p class="lead muted">{t.opens} <span data-drop-when></span>. {t.limited}</p>
        </>
      ) : (
        <>
          <h2>{t.first}</h2>
          <p class="lead muted">{t.firstText}</p>
        </>
      )}
      <PlatformLinks links={labelSocials} variant="chips" hideEmpty />
      <p class="muted small">{t.questions} <Email /></p>
    </div>
    <div class="coming" aria-label={t.coming}>
      {products.map((p) => <ProductCard product={p} comingSoon />)}
    </div>
  </div>
</section>

<script>
  import { pageLocale, tc } from '../i18n/client';
  const gate = document.querySelector<HTMLElement>('[data-drop-gate]');
  if (gate) {
    const at = Date.parse(gate.dataset.dropGate!);
    const when = gate.querySelector<HTMLElement>('[data-drop-when]');
    if (when) when.textContent = tc().dropWhen(new Date(at).toLocaleString(pageLocale(), { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' }));
    const unit = (u: string) => gate.querySelector<HTMLElement>(`[data-u="${u}"]`)!;
    const pad = (n: number) => String(n).padStart(2, '0');
    let timer = 0;
    const tick = () => {
      const left = at - Date.now();
      if (left <= 0) {
        // Drop time: show the shop right away, no reload needed.
        clearInterval(timer);
        gate.hidden = true;
        document.querySelectorAll<HTMLElement>('[data-drop-content]').forEach((el) => (el.hidden = false));
        return;
      }
      const s = Math.floor(left / 1000);
      unit('d').textContent = String(Math.floor(s / 86400));
      unit('h').textContent = pad(Math.floor(s / 3600) % 24);
      unit('m').textContent = pad(Math.floor(s / 60) % 60);
      unit('s').textContent = pad(s % 60);
    };
    tick();
    timer = window.setInterval(tick, 1000);
  }
</script>

<style>
  .soon { display: grid; gap: 2.5rem; align-items: center; }
  .soon h2 { max-width: 14ch; }
  .small { font-size: 0.88rem; margin-top: 1.5rem; }
  .coming { display: grid; gap: 1rem; max-width: 380px; width: 100%; }
  .clock { display: flex; gap: 0.5rem; margin: 0 0 1.25rem; }
  .clock span { display: grid; justify-items: center; min-width: 4.2rem; padding: 0.6rem 0.4rem; border: 1px solid var(--accent); }
  .clock b { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.8rem, 7vw, 2.6rem); line-height: 1; font-variant-numeric: tabular-nums; }
  .clock small { margin-top: 0.3rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.62rem; }
  [data-drop-gate][hidden] { display: none; }
  @media (min-width: 900px) { .soon { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
</style>
