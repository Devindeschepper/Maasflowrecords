---
// Label logo: the MF mark (red outlined F set into the M) next to the name in Old English.
interface Props { size?: 'sm' | 'lg' }
const { size = 'sm' } = Astro.props;
---

<span class:list={['logo', `logo--${size}`]} role="img" aria-label="Maas Flow Records">
  <span class="mark" aria-hidden="true"><span class="m">M</span><span class="f">F</span></span>
  <span class="bar" aria-hidden="true"></span>
  <span class="words" aria-hidden="true">
    <span>Maas Flow</span>
    <span>Records</span>
  </span>
</span>

<style>
  .logo { --mf: 40px; --name: 17px; display: inline-flex; align-items: center; gap: calc(var(--mf) * 0.2); line-height: 1; color: var(--text); }
  .logo--lg { --mf: 64px; --name: 27px; }
  .mark { display: inline-flex; align-items: flex-end; transform: skewX(-8deg); font-family: var(--font-display); font-size: var(--mf); line-height: 0.8; }
  .m { color: var(--text); }
  .f { margin-left: -0.223em; color: transparent; -webkit-text-stroke: calc(var(--mf) * 0.027) var(--accent); }
  .bar { width: 2px; align-self: stretch; margin: 2px 0; background: var(--accent); }
  .words { display: flex; flex-direction: column; font-family: 'UnifrakturCook', serif; font-weight: 700; font-size: var(--name); line-height: 1.02; }
</style>
