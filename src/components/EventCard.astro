---
import type { LabelEvent } from '../data/types';
import { isPast } from '../data/events';
import { fmtEventDate } from '../lib/format';

interface Props { event: LabelEvent; compact?: boolean }
const { event: e, compact = false } = Astro.props;
const d = fmtEventDate(e.start);
const past = isPast(e);
---

<article class:list={['event', { compact, past }]} id={e.slug}>
  <div class="date" aria-hidden="true">
    <span class="day">{d.day}</span>
    <span class="mon">{d.month}</span>
    <span class="yr mono">{d.year}</span>
  </div>

  {!compact && (
    <div class="img">
      <img src={e.image} alt="" width="640" height="360" loading="lazy" decoding="async" />
    </div>
  )}

  <div class="body">
    <p class="eyebrow"><span class="tag">{e.kind}</span></p>
    <h3>{e.title}</h3>
    <p class="where">
      <time datetime={e.allDay ? e.start.slice(0, 10) : e.start}>{e.dateTentative ? 'Expected ' : ''}{d.full}{e.allDay ? '' : ` · ${d.time}`}</time><br />
      <span class="muted">{e.venue}{e.city ? ` — ${e.city}` : ''}</span>
    </p>
    {!compact && <p class="desc muted">{e.description}</p>}
  </div>

  <div class="cta">
    {
      past ? (
        <span class="tag">Past event</span>
      ) : e.ticketUrl ? (
        <a class="btn btn-primary" href={e.ticketUrl} {...(e.ticketUrl.startsWith('/') ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>
          {e.ticketLabel ?? 'Tickets'} <span class="sr-only">for {e.title}</span>
        </a>
      ) : (
        <span class="btn btn-ghost" aria-disabled="true">{e.online ? 'Link soon' : 'Tickets soon'}</span>
      )
    }
  </div>
</article>

<style>
  .event {
    display: grid; grid-template-columns: 64px 1fr; gap: 1rem 1.25rem;
    padding: 1.5rem 0; border-bottom: 1px solid var(--line);
  }
  .date { display: flex; flex-direction: column; align-items: flex-start; line-height: 1; }
  .day { font-family: var(--font-display); font-size: 2.6rem; }
  .mon { font-family: var(--font-display); font-size: 1.1rem; text-transform: uppercase; color: var(--accent); margin-top: 0.2rem; }
  .yr { font-size: 0.68rem; color: var(--muted); margin-top: 0.3rem; }
  .img { grid-column: 1 / -1; order: -1; aspect-ratio: 16 / 9; overflow: hidden; background: var(--surface); border: 1px solid var(--line); }
  .img img { width: 100%; height: 100%; object-fit: cover; }
  .body h3 { margin-bottom: 0.4rem; }
  .body .eyebrow { margin-bottom: 0.6rem; }
  .where { font-size: 0.92rem; margin: 0 0 0.6rem; }
  .desc { font-size: 0.92rem; margin: 0; }
  .cta { grid-column: 2; }
  .past { opacity: 0.6; }
  .past .mon { color: var(--muted); }

  @media (min-width: 800px) {
    .event { grid-template-columns: 90px 280px 1fr auto; align-items: center; gap: 2rem; }
    .event.compact { grid-template-columns: 90px 1fr auto; }
    .img { grid-column: auto; order: 0; }
    .cta { grid-column: auto; }
    .day { font-size: 3.4rem; }
  }
</style>
