---
import { nav, shopOpen } from '../data/site';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container bar">
    <button class="menu-btn" type="button" aria-controls="site-nav" aria-expanded="false">
      <span class="sr-only">Menu</span>
      <span class="bars" aria-hidden="true"><span></span><span></span></span>
    </button>

    <a href="/" class="home-link"><Logo /></a>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      {/* Lit by /api/studio while FL Studio is open on the studio PC (see tools/studio-light). */}
      <button type="button" class="studio-sign" data-studio-light disabled title="Lights up when VIN is in the studio" aria-label="Studio sign: off">
        <span class="long">In the studio</span><span class="short" aria-hidden="true">Studio</span>
      </button>
      <p class="knock-toast" data-knock-toast role="status" aria-live="polite" hidden></p>
      {/* Always shown; while the shop is closed the cart page says "Coming soon". */}
      <a href="/cart/" class="cart-link" aria-label="Shopping cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M5 7h14l-1.2 12.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8L5 7Z" /><path d="M9 7V5a3 3 0 0 1 6 0v2" />
        </svg>
        {shopOpen && <span class="cart-count" data-cart-count hidden>0</span>}
      </a>
    </div>
  </div>
</header>

<script>
  import { cartCount, onCartChange } from '../scripts/cart';

  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const header = document.querySelector('.site-header');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('is-open', !open);
    document.body.style.overflow = open ? '' : 'hidden';
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('is-open')) btn?.click();
  });

  const badge = document.querySelector<HTMLElement>('[data-cart-count]');
  const render = () => {
    const n = cartCount();
    if (!badge) return;
    badge.textContent = String(n);
    badge.hidden = n === 0;
    badge.parentElement?.setAttribute('aria-label', `Shopping cart, ${n} item${n === 1 ? '' : 's'}`);
  };
  render();
  onCartChange(render);

  // Studio sign: checked on load and every 2 minutes while the tab is visible.
  // While it's lit, clicking it "knocks on the door" (one knock per visitor per session).
  const light = document.querySelector<HTMLButtonElement>('[data-studio-light]');
  const toast = document.querySelector<HTMLElement>('[data-knock-toast]');
  let toastTimer = 0;
  const say = (text: string) => {
    if (!toast) return;
    toast.textContent = text;
    toast.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (toast.hidden = true), 4000);
  };
  const setLive = (live: boolean) => {
    if (!light) return;
    light.classList.toggle('is-live', live);
    light.disabled = !live;
    light.title = live ? 'VIN is in the studio right now. Click to knock' : 'Lights up when VIN is in the studio';
    light.setAttribute('aria-label', live ? 'VIN is in the studio right now. Knock on the door' : 'Studio sign: off');
  };
  const checkStudio = async () => {
    if (!light || document.hidden) return;
    try {
      const res = await fetch('/api/studio', { headers: { Accept: 'application/json' } });
      if (res.ok) setLive(Boolean((await res.json()).live));
    } catch {
      /* offline: leave as is */
    }
  };
  light?.addEventListener('click', async () => {
    light.classList.remove('knocked');
    void light.offsetWidth; // restart the shake animation
    light.classList.add('knocked');
    try {
      const res = await fetch('/api/studio/knock', { method: 'POST', headers: { Accept: 'application/json' } });
      const data = await res.json();
      if (res.status === 409) {
        setLive(false);
        say('VIN has just left the studio. Check back soon.');
      } else if (data.ok) {
        const others = Math.max(0, (data.knocks ?? 1) - 1);
        say(
          data.counted
            ? `Knock received. VIN is in the studio working on new music.${others ? ` ${others} other${others === 1 ? '' : 's'} knocked this session.` : ''}`
            : 'Your knock was already received. Thank you for the support.',
        );
      }
    } catch {
      say('Something went wrong. Please try again in a moment.');
    }
  });
  checkStudio();
  setInterval(checkStudio, 120_000);
  document.addEventListener('visibilitychange', checkStudio);
</script>

<style>
  /* Studio sign: dark when VIN is out, glowing red like an ON AIR light when FL Studio is open. */
  .studio-sign {
    appearance: none; display: inline-flex; align-items: center; margin-right: 0.9rem; padding: 0.3rem 0.6rem 0.25rem;
    font-family: var(--font-display); font-size: 0.78rem; line-height: 1; letter-spacing: 0.14em; text-transform: uppercase;
    white-space: nowrap; color: #4a4642; background: #141312; border: 1px solid #2a2725; border-radius: 3px;
    transition: color 0.4s ease, background 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
  }
  .studio-sign.is-live {
    color: #fff4ef; background: var(--accent); border-color: #ff7a63;
    text-shadow: 0 0 6px rgba(255, 220, 210, 0.8);
    box-shadow: 0 0 10px rgba(228, 67, 45, 0.75), 0 0 26px rgba(228, 67, 45, 0.35), inset 0 0 6px rgba(255, 255, 255, 0.25);
    animation: sign-on 0.9s steps(1, end) 1, sign-glow 3.2s ease-in-out 0.9s infinite;
  }
  .studio-sign:disabled { cursor: default; }
  .studio-sign.is-live { cursor: pointer; }
  .studio-sign.is-live:hover, .studio-sign.is-live:focus-visible { filter: brightness(1.12); }
  .studio-sign.knocked { animation: sign-knock 0.35s ease, sign-glow 3.2s ease-in-out 0.35s infinite; }
  @keyframes sign-knock {
    0%, 100% { transform: translateX(0); } 20% { transform: translateX(-3px) rotate(-2deg); }
    40% { transform: translateX(3px) rotate(2deg); } 60% { transform: translateX(-2px); } 80% { transform: translateX(2px); }
  }
  .knock-toast {
    position: absolute; top: calc(100% + 0.6rem); right: 1rem; margin: 0; z-index: 60;
    padding: 0.6rem 0.9rem; max-width: min(320px, calc(100vw - 2rem));
    font-size: 0.85rem; line-height: 1.35; color: var(--text); background: #1a1817;
    border: 1px solid #3a3532; border-left: 3px solid var(--accent); border-radius: 4px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  }
  .knock-toast[hidden] { display: none; }
  .studio-sign .short { display: none; }
  @media (max-width: 600px) {
    .studio-sign { margin-right: 0.5rem; padding: 0.25rem 0.45rem 0.2rem; font-size: 0.7rem; }
    .studio-sign .long { display: none; }
    .studio-sign .short { display: inline; }
  }
  /* A neon tube flickering on, then a slow breathing glow. */
  @keyframes sign-on {
    0%, 20%, 45% { opacity: 1; } 10%, 35% { opacity: 0.35; }
  }
  @keyframes sign-glow {
    0%, 100% { box-shadow: 0 0 10px rgba(228, 67, 45, 0.75), 0 0 26px rgba(228, 67, 45, 0.35), inset 0 0 6px rgba(255, 255, 255, 0.25); }
    50% { box-shadow: 0 0 14px rgba(228, 67, 45, 0.9), 0 0 34px rgba(228, 67, 45, 0.5), inset 0 0 6px rgba(255, 255, 255, 0.3); }
  }
  @media (prefers-reduced-motion: reduce) { .studio-sign.is-live { animation: none; } }
  .site-header {
    position: sticky; top: 0; z-index: 50;
    border-bottom: 1px solid var(--line);
  }
  /* The blur sits on a pseudo-element: backdrop-filter on the header itself would
     trap the fixed mobile menu inside the header's 60px box. */
  .site-header::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: rgba(10, 10, 10, 0.88);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  /* Small screens: menu left, logo in the middle, cart right. */
  .bar { height: var(--header-h); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; }
  .menu-btn { grid-column: 1; justify-self: start; margin-left: -10px; }
  .home-link { grid-column: 2; display: flex; align-items: center; text-decoration: none; }
  .actions { grid-column: 3; justify-self: end; display: flex; align-items: center; gap: 0.25rem; margin-right: -10px; }

  .cart-link { position: relative; display: grid; place-items: center; width: 44px; height: 44px; text-decoration: none; }
  .cart-count {
    position: absolute; top: 4px; right: 2px; min-width: 18px; height: 18px; padding: 0 4px;
    display: grid; place-items: center; border-radius: 9px;
    background: var(--accent); color: #fff; font: 700 0.65rem/1 var(--font-body);
  }
  .cart-count[hidden] { display: none; }

  .menu-btn { width: 44px; height: 44px; display: grid; place-items: center; background: none; border: 0; color: inherit; cursor: pointer; }
  .bars { display: grid; gap: 6px; width: 22px; }
  .bars span { height: 2px; background: currentColor; transition: transform 0.2s; }
  .is-open .bars span:first-child { transform: translateY(4px) rotate(45deg); }
  .is-open .bars span:last-child { transform: translateY(-4px) rotate(-45deg); }

  /* mobile: full-screen overlay menu */
  .nav {
    position: fixed; inset: var(--header-h) 0 0 0; background: var(--bg);
    padding: 1.5rem var(--gutter); overflow-y: auto;
    visibility: hidden; opacity: 0; transition: opacity 0.2s, visibility 0.2s;
  }
  .is-open .nav { visibility: visible; opacity: 1; }
  .nav ul { list-style: none; margin: 0; padding: 0; }
  .nav li { border-bottom: 1px solid var(--line); }
  .nav a {
    display: block; padding: 0.7rem 0; text-decoration: none;
    font-family: var(--font-display); font-size: 2rem; text-transform: uppercase;
  }
  .nav a[aria-current='page'] { color: var(--accent); }

  /* desktop: logo left, page links, cart right */
  @media (min-width: 1080px) {
    .bar { display: flex; justify-content: space-between; }
    .menu-btn { display: none; }
    .actions { margin-right: 0; }
    .nav { position: static; visibility: visible; opacity: 1; padding: 0; background: none; overflow: visible; }
    .nav ul { display: flex; gap: 1.4rem; }
    .nav li { border: 0; }
    .nav a {
      padding: 0.4rem 0; font: 500 0.74rem/1 var(--font-body); letter-spacing: 0.14em;
      color: var(--muted); border-bottom: 1px solid transparent;
    }
    .nav a:hover { color: var(--text); }
    .nav a[aria-current='page'] { color: var(--text); border-bottom-color: var(--accent); }
  }
</style>
