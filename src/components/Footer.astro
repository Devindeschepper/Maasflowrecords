---
import { site, nav, labelSocials, shopOpen } from '../data/site';
import Logo from './Logo.astro';
import PlatformLinks from './PlatformLinks.astro';
import { getLang, localize } from '../i18n';
import { ui } from '../i18n/ui';

const lang = getLang(Astro);
const t = ui[lang].footer;
const nl = ui[lang].nav;
const L = (href: string) => localize(href, lang);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="brand">
        <Logo size="lg" />
        <p class="muted">{t.label}</p>
        <p><a class="btn btn-ghost contact-btn" href={L('/contact/')}>{t.contactBtn}</a></p>
      </div>

      <nav aria-label={t.nav}>
        <ul class="links">
          {nav.map((i) => <li><a href={L(i.href)}>{nl[i.href] ?? i.label}</a></li>)}
          <li><a href={L('/#label')}>{t.about}</a></li>
          <li><a href={L('/press/')}>{t.press}</a></li>
          <li><a href={L('/contact/')}>{t.contact}</a></li>
          {shopOpen && <li><a href={L('/cart/')}>{t.cart}</a></li>}
          {shopOpen && <li><a href={L('/shop/#shipping')}>{t.shipping}</a></li>}
          <li><a href="/terms/" hreflang="en">{t.terms}</a></li>
          <li><a href="/privacy/" hreflang="en">{t.privacy}</a></li>
        </ul>
      </nav>

      <div class="social">
        <p class="eyebrow">{t.follow}</p>
        <PlatformLinks links={labelSocials} variant="icons" context={t.onSocial} />
      </div>
    </div>

    <div class="bottom mono">
      <span>© {year} {site.name}. {t.rights}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); padding: 3.5rem 0 1.5rem; }
  .top { display: grid; gap: 2.5rem; }
  @media (min-width: 900px) { .top { grid-template-columns: 1.3fr 1fr 1fr; } }
  .brand p { margin: 1rem 0 0.5rem; }
  .contact-btn { margin-top: 1rem; }
  .links { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 2rem; }
  .links a { display: inline-block; padding: 0.35rem 0; text-decoration: none; color: var(--muted); font-size: 0.9rem; }
  .links a:hover { color: var(--text); }
  .bottom {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem;
    margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.7rem;
  }
</style>
