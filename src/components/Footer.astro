---
import { site, nav, labelSocials, shopOpen } from '../data/site';
import Logo from './Logo.astro';
import PlatformLinks from './PlatformLinks.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="brand">
        <Logo size="lg" />
        <p class="muted">Independent music label.</p>
        <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
        <p><a class="btn btn-ghost contact-btn" href="/contact/">Contact &amp; bookings</a></p>
      </div>

      <nav aria-label="Footer">
        <ul class="links">
          {nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          <li><a href="/#label">About the label</a></li>
          <li><a href="/contact/">Contact</a></li>
          {shopOpen && <li><a href="/cart/">Cart</a></li>}
          {shopOpen && <li><a href="/shop/#shipping">Shipping &amp; returns</a></li>}
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </nav>

      <div class="social">
        <p class="eyebrow">Follow</p>
        <PlatformLinks links={labelSocials} variant="icons" context="Maas Flow Records on" />
      </div>
    </div>

    <div class="bottom mono">
      <span>© {year} {site.name}. All rights reserved.</span>
      <span>Independent since day one</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); padding: 3.5rem 0 1.5rem; }
  .top { display: grid; gap: 2.5rem; }
  @media (min-width: 900px) { .top { grid-template-columns: 1.3fr 1fr 1fr; } }
  .brand p { margin: 1rem 0 0.5rem; }
  .mail { font-weight: 500; }
  .contact-btn { margin-top: 1rem; }
  .links { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 2rem; }
  .links a { display: inline-block; padding: 0.35rem 0; text-decoration: none; color: var(--muted); font-size: 0.9rem; }
  .links a:hover { color: var(--text); }
  .bottom {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem;
    margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.7rem;
  }
</style>
