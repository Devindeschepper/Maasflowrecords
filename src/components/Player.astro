---
// Privacy-friendly embedded player: nothing loads from Spotify/YouTube
// until the visitor clicks "Load player" (no third-party cookies by default).
import type { Release } from '../data/types';

interface Props { embed: NonNullable<Release['embed']>; title: string }
const { embed, title } = Astro.props;

const src =
  embed.provider === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${encodeURIComponent(embed.src)}`
    : embed.src;
const height = embed.provider === 'youtube' ? undefined : embed.provider === 'spotify' ? 152 : 166;
const label = { spotify: 'Spotify', youtube: 'YouTube', soundcloud: 'SoundCloud' }[embed.provider];
---

<div class:list={['player', `player--${embed.provider}`]} data-player data-src={src} data-title={`${title} — ${label} player`} data-height={height}>
  <button type="button" class="btn btn-ghost load">
    ▶ Load {label} player
  </button>
  <p class="mono muted note">Loads content from {label}.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = el.dataset.src!;
      f.title = el.dataset.title!;
      f.loading = 'lazy';
      f.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
      f.style.width = '100%';
      f.style.border = '0';
      if (el.dataset.height) f.height = el.dataset.height;
      else f.style.aspectRatio = '16 / 9';
      el.replaceChildren(f);
    });
  });
</script>

<style>
  .player { display: grid; gap: 0.5rem; justify-items: start; padding: 1rem; border: 1px solid var(--line); background: var(--surface); }
  .note { margin: 0; font-size: 0.68rem; }
</style>
